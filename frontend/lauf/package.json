{
  "name": "@askrcode/lauf",
  "version": "0.13.1",
  "description": "UI components for Askr apps, built on Svelte 5 and Inertia.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "LICENSE",
    "NOTICE.md",
    "!src/**/*.test.js"
  ],
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./inertia": {
      "svelte": "./src/inertia/index.js",
      "default": "./src/inertia/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./icons/*": "./src/icons/*/index.js"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "prepare": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "play": "vite build --config playground/vite.config.js && vite preview --config playground/vite.config.js --port 4173"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.1",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@inertiajs/svelte": "^3.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@inertiajs/svelte": "^3.7.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/svelte": "^5.2.6",
    "axe-core": "^4.10.2",
    "heroicons": "^2.2.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "peerDependenciesMeta": {
    "@inertiajs/svelte": {
      "optional": true
    }
  }
}
