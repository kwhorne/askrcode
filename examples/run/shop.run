# Rún v0.1.
#
# What the language gives that Pascal cannot: one generic declaration that
# becomes concrete, typed functions — and "with", which is a reserved word in
# Pascal and therefore impossible as a name for eager loading there.
#
# No columns, types or relations are written here. All of it is read from the
# database while this is being translated.

db "sqlite:.build/run/shop.db"

model Customer from customers
model Order    from orders

# One declaration, two typed functions: CustomerById and OrderById.
# In Pascal this would have needed two nearly identical functions, or a
# generic method the compiler refuses to accept.
query<M> ById(id: int) -> M for Customer, Order

query ActiveCustomers(minBalance: money) -> [Customer]:
  from Customer
  where balance >= minBalance and active == true
  with orders
  order by balance desc, name
  limit 10

query CustomersMissingWeight() -> [Customer]:
  from Customer
  where weight is null

query LargeOrders(floor: money) -> [Order]:
  from Order
  where amount >= floor
  order by amount desc
  limit 5

query SearchCustomers(pattern: text) -> [Customer]:
  from Customer
  where email like pattern
  order by name
