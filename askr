#!/usr/bin/env sh
# askr — byggskript for selve rammeverket.
#
# Ikke å forveksle med CLI-en fra PRD-en, som nå finnes: den er et
# Pascal-program i cli/askr.lpr, den bygges med `./askr cli`, og den brukes
# i en *app*. Dette skriptet bygger og tester rammeverket selv, som ikke er
# en app og derfor ikke har noen askr.toml.
#
# Bruker fpc fra PATH når den finnes, ellers docker-imaget fra
# tools/Dockerfile.fpc. Intet annet oppsett.

set -e

ROOT=$(cd "$(dirname "$0")" && pwd)

# ASKR_ARCH=amd64 bygger og kjører alt for x86_64 i container, uansett hva
# maskinen er. Det finnes fordi arkitektur er en ekte akse: første gang
# rammeverket ble bygget for x86_64 kompilerte det ikke, og 705 tester på
# aarch64 hadde ikke sagt fra. Se `./askr test:amd64`.
#
# .ppu-filer er bundet til målet, så de to byggene kan ikke dele katalog.
if [ "$ASKR_ARCH" = "amd64" ]; then
  BUILD="$ROOT/.build-amd64"
  IMAGE=askr-fpc:bookworm-amd64
  DOCKER_PLATFORM="--platform linux/amd64"
  ASKR_FPC=""            # tving containeren, selv med fpc på PATH
  ASKR_FORCE_DOCKER=1
else
  BUILD="$ROOT/.build"
  IMAGE=askr-fpc:bookworm
  DOCKER_PLATFORM=""
fi
UNITS="$BUILD/units"
BIN="$BUILD/bin"

# Finner en lokal fpc. ASKR_FPC peker på en bestemt kompilator; ellers brukes
# den som står på PATH. En fpcupdeluxe-installasjon legger fpc.cfg ved siden av
# binæren, og der leter ikke FPC selv på Unix — derfor settes PPC_CONFIG_PATH.
LOCAL_FPC=""
if [ -n "$ASKR_FPC" ] && [ -x "$ASKR_FPC" ]; then
  LOCAL_FPC="$ASKR_FPC"
elif command -v fpc >/dev/null 2>&1; then
  LOCAL_FPC=$(command -v fpc)
fi

if [ -n "$LOCAL_FPC" ]; then
  FPCDIR=$(dirname "$LOCAL_FPC")
  if [ -f "$FPCDIR/fpc.cfg" ]; then
    PPC_CONFIG_PATH="$FPCDIR"
    export PPC_CONFIG_PATH
  fi
  # RTL-objektene fra fpcupdeluxe er bygget for macOS 11, mens FPC sender
  # -macosx_version_min 10.15 til linkeren. -WM retter det ved kilden.
  if [ "$(uname -s)" = "Darwin" ]; then
    DARWIN_FLAGS="-WM11.0"
  fi
fi

have_local_fpc() {
  [ -z "$ASKR_FORCE_DOCKER" ] && [ -n "$LOCAL_FPC" ]
}

# -B    : bygg alt. Avhengighetssjekken mot .ppu-ene er ikke til å stole på
#         her, og steg 6 erstatter dette skriptet med ekte inkrementell
#         kompilering. Fram til da er korrekt viktigere enn raskt.
# -Sh   : ansistrings
# -O2   : optimalisering uten å gjøre feilsøking ubrukelig
# -gl   : linjenummer i stacktrace
# -vewn : feil, advarsler og notiser — resten er støy
FPCFLAGS="-B -Sh -O2 -gl -vewn $DARWIN_FLAGS -Fu$ROOT/src/cli -Fu$ROOT/src/core -Fu$ROOT/src/http -Fu$ROOT/src/urd -Fu$ROOT/src/norn -Fu$ROOT/src/inertia -Fu$ROOT/src/desktop -Fu$ROOT/src/runtime -Fu$ROOT/src/run -FU$UNITS -FE$BIN"

ensure_image() {
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "Bygger $IMAGE (én gang) ..."
    docker build $DOCKER_PLATFORM -f "$ROOT/tools/Dockerfile.fpc" \
      -t "$IMAGE" "$ROOT/tools"
  fi
}

# Kjører fpc med argumentene som følger, lokalt eller i container.
# Avbryter ved kompileringsfeil. Uten det kjører neste steg videre på den
# forrige binæren, og en suite kan melde grønt på kode som ikke kompilerer.
fpc_run() {
  if have_local_fpc; then
    ( cd "$ROOT" && "$LOCAL_FPC" $FPCFLAGS "$@" )
  else
    ensure_image
    docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
      fpc $(echo "$FPCFLAGS" | sed "s|$ROOT|/work|g") "$@"
  fi
  status=$?
  if [ $status -ne 0 ]; then
    echo "askr: kompileringen feilet for $* — stopper." >&2
    exit $status
  fi
}

# Kjører en ferdig binær, lokalt eller i container. Porter videreføres.
bin_run_quiet() {
  target=$1
  shift
  if have_local_fpc; then
    "$BIN/$target" "$@"
  else
    ensure_image
    docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
      "${BIN#$ROOT/}/$target" "$@"
  fi
}

COMPOSE="$ROOT/tools/docker-compose.yml"
DB_NET=tools_default

cmd_db_up() {
  docker compose -f "$COMPOSE" up -d
  echo "Venter på Postgres ..."
  until docker exec askr-postgres pg_isready -U askr -d askr_dev >/dev/null 2>&1; do
    sleep 1
  done
  echo "Postgres klar på 127.0.0.1:5433 (bruker askr, base askr_dev)"
  echo "Venter på MySQL ..."
  until docker exec askr-mysql \
      mysqladmin ping -h 127.0.0.1 -uaskr -paskr >/dev/null 2>&1; do
    sleep 1
  done
  echo "MySQL klar på 127.0.0.1:3308 (bruker askr, base askr_dev)"
}

cmd_db_down() {
  docker compose -f "$COMPOSE" down
}

cmd_urd() {
  prepare
  DB_SRC=/work/examples/urddemo/urddemo.lpr
  fpc_run examples/urddemo/urddemo.lpr
  run_against_db urddemo
}

# Frontend bygges med Vite; Askr serverer resultatet statisk.
cmd_web() {
  prepare
  if [ ! -f "$ROOT/examples/inertia/public/build/.vite/manifest.json" ] \
     || [ "$1" = "--build" ]; then
    echo "Bygger frontend ..."
    ( cd "$ROOT/examples/inertia/frontend" && npm install --silent --no-fund --no-audit && npm run build )
  fi
  fpc_run examples/inertia/inertiademo.lpr
  port=${2:-8080}
  if have_local_fpc; then
    ASKR_WEB_ROOT="$ROOT/examples/inertia" "$BIN/inertiademo" "$port"
  else
    ensure_image
    docker run --rm -it -p "$port:$port" -v "$ROOT":/work -w /work \
      -e ASKR_WEB_ROOT=/work/examples/inertia \
      "$IMAGE" /work/.build/bin/inertiademo "$port" 0.0.0.0
  fi
}

# Lauf — UI-komponentene. Egen suite fordi den trenger node, ikke fpc.
#
# Hopper over seg selv når node mangler, på samme måte som desktop-suiten
# hopper over seg selv uten GTK. Et hopp som sier hvorfor, ikke et hopp i
# stillhet — ./askr test skal ikke kreve npm for å være grønn.
cmd_lauf() {
  LAUF="$ROOT/frontend/lauf"
  if ! command -v node >/dev/null 2>&1; then
    echo "askr — lauf"
    echo
    echo "HOPPET OVER: node finnes ikke på denne maskinen."
    echo "  Lauf er frontend-biblioteket og bygges med npm, ikke med fpc."
    echo "  Installer node og kjør ./askr lauf igjen."
    return 0
  fi
  if [ ! -d "$LAUF/node_modules" ]; then
    echo "Installerer avhengigheter ..."
    ( cd "$LAUF" && npm install --silent --no-fund --no-audit ) || return 1
  fi
  # Ikonene er generert og sjekkes ikke inn; prepare lager dem ved install,
  # men et tre som er sjekket ut på nytt har dem ikke.
  if [ ! -d "$LAUF/src/icons" ]; then
    ( cd "$LAUF" && npm run --silent icons ) || return 1
  fi
  ( cd "$LAUF" && npx vitest run "$@" )
}

# Lekegrinda: komponentene i en ekte nettleser. Den finnes fordi jsdom ikke
# legger ut noe, og derfor ikke kan bevise fokusfelle, flytende plassering,
# rullelås eller at en kalender lar seg styre med piltaster.
cmd_lauf_play() {
  LAUF="$ROOT/frontend/lauf"
  if ! command -v node >/dev/null 2>&1; then
    echo "askr: lekegrinda trenger node." >&2
    return 1
  fi
  [ -d "$LAUF/node_modules" ] || ( cd "$LAUF" && npm install --silent --no-fund --no-audit )
  [ -d "$LAUF/src/icons" ] || ( cd "$LAUF" && npm run --silent icons )
  ( cd "$LAUF" && npm run --silent play )
}

# Kontrast og skjermdump i en ekte nettleser.
#
# axe kan ikke måle kontrast i jsdom — det legges ikke ut noe og fargene
# regnes ikke ut — så kontrastregelen er slått av i enhetstestene og kjøres
# her i stedet. Seks kombinasjoner: lys, mørk via prefers-color-scheme og
# mørk via data-theme, hver på 390 og 1280 px. Skjermdumpene havner i
# frontend/lauf/.shots.
cmd_lauf_check() {
  LAUF="$ROOT/frontend/lauf"
  CHROME=${ASKR_CHROME:-"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"}
  if ! command -v node >/dev/null 2>&1; then
    echo "askr — lauf:check"
    echo
    echo "HOPPET OVER: node finnes ikke."
    return 0
  fi
  if [ ! -x "$CHROME" ] && ! command -v "$CHROME" >/dev/null 2>&1; then
    echo "askr — lauf:check"
    echo
    echo "HOPPET OVER: fant ingen Chrome på $CHROME."
    echo "  Sett ASKR_CHROME til stien, eller installer Chrome."
    echo "  Dette er den eneste sjekken som kan måle kontrast —"
    echo "  jsdom legger ikke ut noe og kan ikke gjøre det."
    return 0
  fi
  [ -d "$LAUF/node_modules" ] || ( cd "$LAUF" && npm install --silent --no-fund --no-audit )
  [ -d "$LAUF/src/icons" ] || ( cd "$LAUF" && npm run --silent icons )

  ( cd "$LAUF" && npx vite build --config playground/vite.config.js >/dev/null ) || return 1

  PORT=${ASKR_LAUF_PORT:-4173}
  ( cd "$LAUF/playground/dist" && python3 -m http.server "$PORT" >/dev/null 2>&1 ) &
  SRV=$!
  PROFILE=$(mktemp -d)
  "$CHROME" --headless --disable-gpu --remote-debugging-port=9222 \
    --user-data-dir="$PROFILE" about:blank >/dev/null 2>&1 &
  BROWSER=$!
  # Vent til begge svarer, i stedet for å gjette på en sleep.
  n=0
  until curl -s "http://127.0.0.1:9222/json/list" >/dev/null 2>&1 && \
        curl -s "http://127.0.0.1:$PORT/" >/dev/null 2>&1; do
    n=$((n + 1))
    [ $n -gt 60 ] && { echo "askr: nettleser eller server startet ikke" >&2; break; }
    sleep 0.5
  done

  LAUF_URL="http://127.0.0.1:$PORT/" node "$LAUF/tests/browser/check.mjs"
  status=$?

  # Vent til begge faktisk er borte før profilen slettes — Chrome skriver
  # fortsatt til den et øyeblikk etter SIGTERM, og da feiler rm halvveis.
  kill "$SRV" "$BROWSER" 2>/dev/null
  wait "$SRV" "$BROWSER" 2>/dev/null
  rm -rf "$PROFILE" 2>/dev/null
  return $status
}

cmd_schema() {
  prepare
  # Relativ sti, ikke absolutt: både binæren og fpc kan kjøre i containeren
  # med /work som arbeidskatalog, og en vertssti finnes ikke der. Med den
  # absolutte varianten skrev norndemo filene gjennom fallbacken sin, mens
  # verify lette etter dem på vertsstien og feilet med «Can't find unit
  # App.Schema.Customers».
  SCHEMA_OUT="${BUILD#$ROOT/}/schema"
  ASKR_SCHEMA_OUT="$SCHEMA_OUT"
  export ASKR_SCHEMA_OUT
  DB_SRC=/work/examples/norndemo/norndemo.lpr
  fpc_run -Fuexamples/norndemo examples/norndemo/norndemo.lpr
  run_against_db norndemo

  # Det avgjørende steget: kompiler koden Norn nettopp genererte, og bruk den.
  echo
  echo "Kompilerer mot generert skjema ..."
  DB_SRC=/work/examples/norndemo/verify.lpr
  fpc_run -Fu"$SCHEMA_OUT" examples/norndemo/verify.lpr
  run_against_db verify
}

# Spiken trenger en database. Kjører fpc lokalt, går den mot porten på
# hosten; i container må den inn på compose-nettverket og bruke tjenestenavnet.
# Driveren laster libpq med dlopen ved første bruk. Finnes den ikke lokalt,
# kan ikke en nativ binaer snakke med databasen, og da bygges og kjores
# demoen i containeren i stedet.
have_local_libpq() {
  for p in /opt/homebrew/opt/libpq/lib/libpq.5.dylib \
           /usr/local/opt/libpq/lib/libpq.5.dylib \
           /Applications/Postgres.app/Contents/Versions/latest/lib/libpq.5.dylib \
           /usr/lib/libpq.so.5 /usr/lib/x86_64-linux-gnu/libpq.so.5 \
           /usr/lib/aarch64-linux-gnu/libpq.so.5; do
    [ -e "$p" ] && return 0
  done
  return 1
}

run_against_db() {
  target=$1
  if ! docker ps --format '{{.Names}}' | grep -qx askr-postgres; then
    echo "askr-postgres kjører ikke. Kjør: ./askr db:up" >&2
    exit 1
  fi
  if have_local_fpc && ! have_local_libpq; then
    echo "(ingen libpq lokalt — bygger og kjører $target i container)"
    ensure_image
    docker run --rm --network "$DB_NET" -v "$ROOT":/work -w /work \
      -e ASKR_PG_DSN="${ASKR_PG_DSN:-postgresql://askr:askr@askr-postgres:5432/askr_dev}" \
      -e ASKR_SCHEMA_OUT="/work/.build/schema" \
      "$IMAGE" sh -c "fpc $(echo "$FPCFLAGS" | sed "s|$ROOT|/work|g" | sed 's/-WM11.0//') -Fu/work/examples/norndemo -Fu/work/.build/schema $DB_SRC >/dev/null 2>&1 && /work/.build/bin/$target"
    return
  fi
  if have_local_fpc; then
    ASKR_PG_DSN=${ASKR_PG_DSN:-postgresql://askr:askr@127.0.0.1:5433/askr_dev} \
      "$BIN/$target"
  else
    ensure_image
    docker run --rm --network "$DB_NET" -v "$ROOT":/work -w /work \
      -e ASKR_PG_DSN="${ASKR_PG_DSN:-postgresql://askr:askr@askr-postgres:5432/askr_dev}" \
      "$IMAGE" "/work/.build/bin/$target"
  fi
}

cmd_spike() {
