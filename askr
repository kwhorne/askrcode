# Selvsignerte sertifikater til TLS-testene. De ligger i .build og hører
# ikke hjemme noe annet sted.
cmd_tls_certs() {
  out="$BUILD/tls"
  mkdir -p "$out"
  if [ -f "$out/cert.pem" ] && [ "${1:-}" != "--force" ]; then
    echo "Finnes allerede: $out/cert.pem (--force for å lage nye)"
    return 0
  fi
  openssl req -x509 -newkey rsa:2048 -keyout "$out/key.pem" \
    -out "$out/cert.pem" -days 365 -nodes -subj "/CN=localhost" \
    -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" 2>/dev/null
  # Et par som ikke hører sammen, til feilstien i testene.
  openssl req -x509 -newkey rsa:2048 -keyout "$out/other-key.pem" \
    -out "$out/other-cert.pem" -days 365 -nodes -subj "/CN=annen" 2>/dev/null
  echo "Sertifikater i $out"
}

# MySQL-suiten må nå serveren. Natively holder den publiserte porten 3308;
# i container må vi inn på compose-nettet og bruke tjenestenavnet.
mysql_dsn_and_net() {
  MYSQL_NET=""
  MYSQL_DSN="mysql://askr:askr@127.0.0.1:3308/askr_dev"
  if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^askr-mysql$'; then
    return 0
  fi
  if ! have_local_fpc; then
    net=$(docker inspect askr-mysql \
      --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' 2>/dev/null)
    if [ -n "$net" ]; then
      MYSQL_NET="$net"
      MYSQL_DSN="mysql://askr:askr@askr-mysql:3306/askr_dev"
    fi
  fi
}

cmd_mysql() {
  prepare
  mysql_dsn_and_net
  fpc_run tests/askr_mysql_tests.lpr
  if have_local_fpc; then
    ASKR_MYSQL_DSN="$MYSQL_DSN" "$BIN/askr_mysql_tests"
  else
    ensure_image
    docker run --rm $DOCKER_PLATFORM ${MYSQL_NET:+--network "$MYSQL_NET"} \
      -e ASKR_MYSQL_DSN="$MYSQL_DSN" \
      -v "$ROOT":/work -w /work "$IMAGE" "${BIN#$ROOT/}/askr_mysql_tests"
  fi
}

cmd_pg() {
  prepare
  net=""
  dsn="postgresql://askr:askr@127.0.0.1:5433/askr_dev"
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^askr-postgres$' \
     && ! have_local_fpc; then
    net=$(docker inspect askr-postgres \
      --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' 2>/dev/null)
    [ -n "$net" ] && dsn="postgresql://askr:askr@askr-postgres:5432/askr_dev"
  fi
  fpc_run tests/askr_pg_tests.lpr
  if have_local_fpc; then
    ASKR_PG_DSN="$dsn" "$BIN/askr_pg_tests"
  else
    ensure_image
    docker run --rm $DOCKER_PLATFORM ${net:+--network "$net"} \
      -e ASKR_PG_DSN="$dsn" \
      -v "$ROOT":/work -w /work "$IMAGE" "${BIN#$ROOT/}/askr_pg_tests"
  fi
}

# GTK-imaget er separat fordi WebKitGTK drar inn noen hundre megabyte, og
# ./askr test skal ikke betale for det.
