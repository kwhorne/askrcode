  if ! docker image inspect askr-fpc:gtk >/dev/null 2>&1; then
    ensure_image
    echo "Bygger askr-fpc:gtk (GTK3 + WebKitGTK) ..."
    docker build -t askr-fpc:gtk -f "$ROOT/tools/Dockerfile.gtk" "$ROOT/tools" \
      >/dev/null
  fi
}

# Kjører Linux-webviewen på ordentlig, under Xvfb.
cmd_desktop_linux() {
  prepare
  ensure_gtk_image
  docker run --rm -v "$ROOT":/work -w /work askr-fpc:gtk sh -c '
    fpc -B -Sh -O2 -vew -Fu/work/src/core -Fu/work/src/http -Fu/work/src/urd \
      -Fu/work/src/runtime -Fu/work/src/desktop \
      -FU/work/.build/units-gtk -FE/work/.build/bin \
      /work/tests/askr_desktop_tests.lpr >/tmp/c.log 2>&1 \
      || { grep -E "Error|Fatal" /tmp/c.log | head -5; exit 1; }
    Xvfb :99 -screen 0 1280x800x24 >/dev/null 2>&1 &
    sleep 2
    DISPLAY=:99 /work/.build/bin/askr_desktop_tests
  ' 2>&1 | grep -vE "dbind-WARNING|AT-SPI"
}

# Samme suiter, men med område-, overflyt- og I/O-kontroll slått på.
#
# Dette er ikke bare strengere kompilering: -Co gjør enhver tilsiktet
# heltallsoverflyt til en feil, og det avslørte at fire FNV-hasher hvilte på
# wraparound uten å si fra. De er nå merket med {$R-}{$Q-}. Kjør denne når du
# har rørt aritmetikk eller indeksering.
cmd_check() {
  FPCFLAGS="$FPCFLAGS -Cr -Co -Ci"
  echo "askr: bygger med -Cr -Co -Ci (område, overflyt, I/O)"
  echo
  cmd_test "$@"
}

# Rún ende-til-ende: kilde -> introspeksjon av en ekte database -> typesjekk
# -> Pascal -> fpc -> binær som spør den samme databasen. Testsuiten dekker
# transpileren; dette dekker at leddene etter den henger sammen, og er
# samtidig målingen av hva comptime-introspeksjonen koster.
cmd_run_demo() {
  prepare
  fpc_run examples/run/setupdb.lpr
  bin_run_quiet setupdb "${1:-0}"

  echo
  echo "— transpilering (comptime leser skjemaet her)"
  fpc_run examples/run/transpile.lpr
  # Relativ sti, ikke absolutt: argumentet leses av en binær som i
  # container-modus kjører med /work som arbeidskatalog, og en vertssti
  # finnes ikke der. Målet kom aldri lenger enn til «Can't find unit
  # Shop.Gen» uten en lokal fpc.
  bin_run_quiet transpile examples/run/shop.run \
    "${BUILD#$ROOT/}/run/Shop.Gen.pas" Shop.Gen

  echo
  echo "— generert Pascal gjennom fpc, og kjørt"
  fpc_run -Fu"${BUILD#$ROOT/}/run" examples/run/rundemo.lpr
  bin_run_quiet rundemo
}

# Porten for den arkitektoniske innsatsen i MCP-laget: serveren skal svare
# selv om prosjektet ikke kompilerer, og selv om det ikke finnes et prosjekt
# i det hele tatt. Det kan ikke testes fra Pascal-suiten — det krever en ekte
# prosess med ekte rør — så det er et eget mål.
#
# Den sjekker også at stdout er ren. Én WriteLn på feil side av McpServe, og
# klienten ser en parse-feil i stedet for et svar, uten noe som sier hvor den
# kom fra.
# What a reader without JavaScript gets, and whether the client replaces it.
#
# The server half is in askr_tests: strip the scripts, count the characters.
# This is the half that needs a browser -- Svelte 5 mounts by appending, so
# whether the fallback is replaced or left beside the app depends on one
# line in main.js, and neither jsdom nor a Pascal test runs Inertia's mount.
#
# Skips itself without node or Chrome, like the desktop suite without GTK.
# A skip that does not say why is worse than a failure.
# The gate for the API layer: the document is really OpenAPI, and the
# pieces it describes really behave that way.
#
# Written in English like cmd_mcp_check; the rest of this script is
# Norwegian from before and stays that way.
cmd_api_check() {
  prepare

  fail=0
  ok()   { echo "  ok    $1"; }
  bad()  { echo "  FAIL  $1"; shift; [ $# -gt 0 ] && printf '        %s\n' "$@"; fail=1; }
  has()  { case "$2" in *"$1"*) return 0;; *) return 1;; esac; }

  echo "Bygger apidemo ..."
  fpc_run examples/api/apidemo.lpr >/dev/null

  work="$BUILD/apicheck"
  rm -rf "$work"
  mkdir -p "$work"

  # Every console call goes to the same database file the server uses,
  # so a token issued here is a token the server can see.
  api_console() {
    if have_local_fpc; then
      APIDEMO_DB="$work/apidemo.sqlite" "$BIN/apidemo" "$@"
    else
      ensure_image
      docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work \
        -e APIDEMO_DB="/work/${work#$ROOT/}/apidemo.sqlite" "$IMAGE" \
        "${BIN#$ROOT/}/apidemo" "$@"
    fi
  }

  echo
  echo "- the document"

  doc="$work/openapi.json"
  if ! api_console --openapi > "$doc" 2>"$work/err.txt"; then
    bad "the document is generated" "$(head -3 "$work/err.txt")"
    return 1
  fi
  ok "the document is generated"

  # A real validator, not a shape we believe in. The suite checks that
  # the fields we meant to write are where we meant to put them, which
  # is a check against our own understanding of OpenAPI. This one is a
  # check against OpenAPI.
  if ! command -v node >/dev/null 2>&1; then
    echo "  (skipped: node is not here, so nothing validated the document)"
  else
    if [ ! -d "$ROOT/tools/openapi/node_modules" ]; then
      echo "  installing the validator ..."
      ( cd "$ROOT/tools/openapi" &&
        npm install --silent --no-fund --no-audit ) >/dev/null 2>&1 || true
    fi
    out=$(cd "$ROOT" && node tools/openapi/validate.mjs "$doc" 2>&1)
    if [ $? -eq 0 ]; then
      ok "a real validator accepts it: ${out#ok: }"
    else
      bad "a real validator accepts it" "$out"
    fi

    # And the validator is not a rubber stamp. A document with its
    # version taken out has to be refused, or "valid" above means
    # nothing.
    node -e '
      const fs=require("fs");
      const d=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
      delete d.openapi;
      fs.writeFileSync(process.argv[2], JSON.stringify(d));
    ' "$doc" "$work/broken.json"
    if (cd "$ROOT" && node tools/openapi/validate.mjs "$work/broken.json") >/dev/null 2>&1; then
      bad "and refuses one that is not valid" \
          "a document with no openapi version passed"
    else
      ok "and refuses one that is not valid"
    fi
  fi

  echo
  echo "- what the document says, and what the routes say"

  if api_console --openapi --check >"$work/drift.txt" 2>&1; then
    ok "the document and the routes agree"
  else
    bad "the document and the routes agree" "$(cat "$work/drift.txt")"
  fi

  echo
  echo "- and the API behaves the way it is described"

  port=8352
  db=/work/${work#$ROOT/}/apidemo.sqlite
  # Natively when there is a local fpc, otherwise in the container with
  # the port mapped out -- fpc_run builds for whichever one it used, and
  # a Linux binary does not run on this host.
  # A name, and removed before it is started. A run that died earlier
  # leaves a container holding the port, and without this the next run
  # quietly talks to *that* one -- a server with another database behind
  # it, which shows up as every token being invalid and nothing saying
  # why. It happened, and the log said "port is already allocated" in a
  # file nobody was reading.
  cname=askr-apicheck
  if have_local_fpc; then
    APIDEMO_DB="$work/apidemo.sqlite" "$BIN/apidemo" "$port" \
      >"$work/server.log" 2>&1 &
  else
    ensure_image
    docker rm -f "$cname" >/dev/null 2>&1 || true
    docker run --rm --name "$cname" -p "$port:$port" $DOCKER_PLATFORM \
      -v "$ROOT":/work -w /work -e APIDEMO_DB="$db" "$IMAGE" \
      "/work/${BIN#$ROOT/}/apidemo" "$port" 0.0.0.0 \
      >"$work/server.log" 2>&1 &
  fi
  demo_pid=$!
  trap 'kill $demo_pid 2>/dev/null; docker rm -f askr-apicheck >/dev/null 2>&1 || true' EXIT INT TERM

  i=0
  while [ $i -lt 80 ]; do
    curl -s -o /dev/null "http://127.0.0.1:$port/openapi.json" 2>/dev/null && break
    i=$((i + 1))
    sleep 0.2
  done
  if [ $i -ge 80 ]; then
    bad "the server came up" "$(tail -3 "$work/server.log" 2>/dev/null)"
    return 1
  fi
  ok "the server came up" 

  body=$(curl -s "http://127.0.0.1:$port/openapi.json")
  if has '"openapi"' "$body"; then
    ok "it serves its own document"
  else
    bad "it serves its own document" "$(echo "$body" | head -2)"
  fi

  # A token with one scope, and one with the other.
  read_tok=$(api_console --token:issue 1 reader --scopes=widgets:read |
    sed -n 's/^  \(askr_.*\)$/\1/p')
  write_tok=$(api_console --token:issue 1 writer --scopes=widgets:write |
    sed -n 's/^  \(askr_.*\)$/\1/p')
  if [ -n "$read_tok" ] && [ -n "$write_tok" ]; then
    ok "two tokens were issued"
  else
    bad "two tokens were issued"
  fi

  code=$(curl -s -o "$work/anon.txt" -w '%{http_code}' \
    "http://127.0.0.1:$port/api/widgets")
  if [ "$code" = "401" ]; then
    ok "no token is a 401"
  else
    bad "no token is a 401" "got $code"
  fi

  code=$(curl -s -o "$work/list.json" -w '%{http_code}' \
    -H "Authorization: Bearer $read_tok" \
    "http://127.0.0.1:$port/api/widgets?sort=name&tier=gold")
  list=$(cat "$work/list.json")
  if [ "$code" = "200" ]; then
    ok "a token with the scope gets the list"
  else
    bad "a token with the scope gets the list" "got $code" "$list"
  fi
  if has '"data":[{' "$list"; then
    ok "and it is the envelope, with rows in it"
  else
    bad "and it is the envelope, with rows in it" "$list"
  fi
  if has '"total":5' "$list"; then
    ok "counted before the page was cut"
  else
    bad "counted before the page was cut" "$list"
  fi
  # The next link has to carry the caller's own parameter forward.
  if has 'tier=gold' "$list" && has 'page=2' "$list"; then
    ok "and the next link keeps what the caller sent"
  else
    bad "and the next link keeps what the caller sent" "$list"
  fi
  # The hidden column is hidden here too, not only in the document.
  if has 'supplier_code' "$list"; then
    bad "a column hidden from JSON stays out of the payload" "$list"
  else
    ok "a column hidden from JSON stays out of the payload"
  fi

  code=$(curl -s -o "$work/forbidden.json" -w '%{http_code}' \
    -X POST -H "Authorization: Bearer $read_tok" \
    -H 'Content-Type: application/json' -H 'Accept: application/json' \
    -d '{"name":"x"}' "http://127.0.0.1:$port/api/widgets")
  if [ "$code" = "403" ]; then
    ok "the read token is refused the write"
  else
    bad "the read token is refused the write" "got $code"
  fi

  code=$(curl -s -o "$work/created.json" -w '%{http_code}' \
    -X POST -H "Authorization: Bearer $write_tok" \
    -H 'Content-Type: application/json' -H 'Accept: application/json' \
    -d '{"name":"From the gate","tier":"gold","price":9.5}' \
    "http://127.0.0.1:$port/api/widgets")
  if [ "$code" = "201" ]; then
    ok "and the write token creates one, with the status the document promised"
  else
    bad "and the write token creates one" "got $code" "$(cat "$work/created.json")"
  fi

  code=$(curl -s -o "$work/invalid.json" -w '%{http_code}' \
    -X POST -H "Authorization: Bearer $write_tok" \
    -H 'Content-Type: application/json' -H 'Accept: application/json' \
    -d '{"tier":"platinum"}' "http://127.0.0.1:$port/api/widgets")
  inv=$(cat "$work/invalid.json")
  if [ "$code" = "422" ]; then
    ok "a body that does not validate is a 422"
  else
    bad "a body that does not validate is a 422" "got $code" "$inv"
  fi
  if has '"errors"' "$inv" && has 'name' "$inv"; then
    ok "with the errors keyed on the column name"
  else
    bad "with the errors keyed on the column name" "$inv"
  fi
  if has 'application/problem+json' "$(curl -s -D - -o /dev/null \
      -X POST -H "Authorization: Bearer $write_tok" \
      -H 'Content-Type: application/json' -H 'Accept: application/json' \
      -d '{"tier":"platinum"}' "http://127.0.0.1:$port/api/widgets")"; then
    ok "as a problem document"
  else
    bad "as a problem document"
  fi

  # CORS: the preflight the document's caller would send.
  head=$(curl -s -D - -o /dev/null -X OPTIONS \
    -H 'Origin: https://app.example' \
    -H 'Access-Control-Request-Method: POST' \
    "http://127.0.0.1:$port/api/widgets")
  if has '204' "$head" && has 'Access-Control-Allow-Origin: https://app.example' "$head"; then
    ok "a preflight is answered, and allows the origin"
  else
    bad "a preflight is answered, and allows the origin" "$head"
  fi
  head=$(curl -s -D - -o /dev/null -X OPTIONS \
    -H 'Origin: https://app.example.evil.example' \
    -H 'Access-Control-Request-Method: POST' \
    "http://127.0.0.1:$port/api/widgets")
  if has 'Access-Control-Allow-Origin' "$head"; then
    bad "and a near miss is not the origin" "$head"
  else
    ok "and a near miss is not the origin"
  fi

  # The rate limit. Burst 20, and the requests above have already spent
  # some, so this is generous about how many it takes.
  i=0
  limited=0
  while [ $i -lt 60 ]; do
    c=$(curl -s -o /dev/null -w '%{http_code}' \
      -H "Authorization: Bearer $read_tok" \
      "http://127.0.0.1:$port/api/widgets")
    if [ "$c" = "429" ]; then
      limited=1
      break
    fi
    i=$((i + 1))
  done
  if [ $limited -eq 1 ]; then
    ok "the rate limit bites"
  else
    bad "the rate limit bites" "sixty requests and never a 429"
  fi
  head=$(curl -s -D - -o /dev/null -H "Authorization: Bearer $read_tok" \
    "http://127.0.0.1:$port/api/widgets")
  if has 'Retry-After:' "$head"; then
    ok "and says how long to wait"
  else
    bad "and says how long to wait" "$head"
  fi

  kill $demo_pid 2>/dev/null || true
  docker rm -f "$cname" >/dev/null 2>&1 || true
  trap - EXIT INT TERM

  echo
  if [ $fail -ne 0 ]; then
    echo "api:check failed."
    return 1
  fi
  echo "api:check holds: the document is OpenAPI, and the API answers as it says."
}

# The gate for the generators: what `askr make` writes has to build, migrate
# on all three databases, and put a row in and get the same row out -- through
# the model it wrote, not through SQL.
#
# Everything runs in the container, where fpc, libpq and MariaDB Connector/C
# all are, on the compose network so Postgres and MySQL answer by name. The
# CLI is built into a directory of its own so the host's .build/bin/askr is
# not replaced by a Linux one.
#
# Written in English like cmd_mcp_check and cmd_api_check.
# The pages make resource wrote, driven in a real Chrome through the app
# in its container and Vite on the host: forms that save, a date that
# survives an edit, errors on the fields they belong to, and axe with
# contrast. Skips itself, saying why, without node, Chrome or a network
# for npm -- the same as lauf:check.
# The generated API the way a user meets it: a token from askr token:issue,
# the server on a socket, and curl. The generated tests drive the router;
# this is the server's own answer to a refusal, its WWW-Authenticate, the
# 204 with nothing in it, and /openapi.json served from what is running.
# Commands an app registers itself, run the way a user runs them: through
# the tool, which has never heard of them and forwards the word, to an app
# that was built with them in it.
make_check_commands() {
  mkdir -p "$work/shop/app/Console"
  cat > "$work/shop/app/Console/App.Console.Hello.pas" <<'EOF'
unit App.Console.Hello;

{$mode Delphi}{$H+}

interface

implementation

uses
  SysUtils, Askr.Console, Askr.Urd.Query, App.Models.Maker;

function Greet(const A: TConsoleArgs): Integer;
begin
  if A.Has('loud') then
    WriteLn(UpperCase('hello ' + A.Arg(1)))
  else
    WriteLn('hello ' + A.Arg(1));
  Result := A.Int('code', 0);
end;

function Boom(const A: TConsoleArgs): Integer;
begin
  raise Exception.Create('the invoices are not ready');
end;

function CountMakers(const A: TConsoleArgs): Integer;
begin
  WriteLn('makers: ', TQuery<TMaker>.New.Count);
  Result := 0;
end;

initialization
  RegisterCommand('hello:greet', 'say hello to someone', @Greet, False);
  RegisterCommand('hello:boom', 'fail on purpose', @Boom, False);
  RegisterCommand('hello:makers', 'count the makers', @CountMakers);
end.
EOF
  sed -i.bak 's|^  App.Migrations, App.Seeders,$|  App.Migrations, App.Seeders, App.Console.Hello,|' "$work/shop/app.lpr"
  rm -f "$work/shop/app.lpr.bak"
  if ! in_box "$askr_bin build" shop >"$work/cmd-build.log" 2>&1; then
    bad "the app builds with commands of its own" "$(grep -E 'rror|Fatal' "$work/cmd-build.log" | head -4)"
    return 0
  fi

  code=0; out=$(in_box "$askr_bin hello:greet Ada --loud" shop 2>&1) || code=$?
  [ $code -eq 0 ] && echo "$out" | grep -q '^HELLO ADA$' &&
    ok "askr hello:greet Ada --loud runs it, with its word and its flag" ||
    bad "askr hello:greet runs the app's command" "exit $code: $out"
  code=0; in_box "$askr_bin hello:greet Ada --code=3" shop >/dev/null 2>&1 || code=$?
  [ $code -eq 3 ] && ok "what it returns is the exit code" || bad "what it returns is the exit code" "exit $code"
  code=0; out=$(in_box "$askr_bin hello:boom" shop 2>&1) || code=$?
  if [ $code -eq 1 ] && echo "$out" | grep -q 'the invoices are not ready' &&
     ! echo "$out" | grep -q 'unhandled exception\|^  \$0000'; then
    ok "one that raises says why in a line, and exits 1"
  else
    bad "one that raises says why in a line" "exit $code: $(echo "$out" | head -3)"
  fi
  code=0; out=$(in_box "$askr_bin hello:makers" shop 2>&1) || code=$?
  [ $code -eq 0 ] && echo "$out" | grep -q '^makers: [0-9]' &&
    ok "one that needs the database has it, and a model works in it" ||
    bad "one that needs the database has it" "exit $code: $out"
  code=0; out=$(in_box "$askr_bin nosuch:thing" shop 2>&1) || code=$?
  [ $code -eq 64 ] && echo "$out" | grep -q 'Unknown command: nosuch:thing' &&
    ok "a word nobody answers is still unknown, with exit 64" ||
    bad "a word nobody answers is still unknown" "exit $code: $out"
  out=$(in_box "$askr_bin list" shop 2>&1) || true
  echo "$out" | grep -q 'hello:greet *say hello to someone' &&
    ok "askr list shows it, with its help" || bad "askr list shows it" "$out"

  # Under set -e an exit code that is not 0 would end the whole gate at
  # the assignment; each one above is caught with || code=$? instead.

  # A name that can never run stops the app, as a sentence and not as a
  # column of addresses from an initialization.
  cat > "$work/shop/app/Console/App.Console.Bad.pas" <<'EOF'
unit App.Console.Bad;

{$mode Delphi}{$H+}

interface

implementation

uses
  Askr.Console;

function Nothing(const A: TConsoleArgs): Integer;
begin
  Result := 0;
end;

initialization
  RegisterCommand('build', 'shadow the tool', @Nothing, False);
end.
EOF
  sed -i.bak 's|App.Console.Hello,$|App.Console.Hello, App.Console.Bad,|' "$work/shop/app.lpr"
  rm -f "$work/shop/app.lpr.bak"
  if in_box "$askr_bin build" shop >"$work/cmd-bad-build.log" 2>&1; then
    code=0; out=$(in_box "$askr_bin about" shop 2>&1) || code=$?
    if [ $code -eq 1 ] && echo "$out" | grep -q "build is the askr tool's own command" &&
       ! echo "$out" | grep -q 'unhandled exception\|^  \$0000'; then
      ok "registering the tool's own word stops the app, saying which"
    else
      bad "registering the tool's own word stops the app" "exit $code: $(echo "$out" | head -3)"
    fi
  else
    bad "the app with a bad command builds" "$(grep -E 'rror|Fatal' "$work/cmd-bad-build.log" | head -3)"
  fi
  sed -i.bak 's| App.Console.Bad,$|,|; s|App.Console.Hello,,$|App.Console.Hello,|' "$work/shop/app.lpr"
  rm -f "$work/shop/app.lpr.bak" "$work/shop/app/Console/App.Console.Bad.pas"
}

make_check_socket() {
  api_port=${ASKR_MAKE_API_PORT:-8354}
  base="http://127.0.0.1:$api_port"
  printf 'APP_ENV=local\nDATABASE_URL=sqlite:storage/api.sqlite\n' > "$work/shop/.env"
  in_box "rm -f storage/api.sqlite && $askr_bin migrate" shop >"$work/sock-migrate.log" 2>&1 || true
  in_box "$askr_bin token:issue 1 writer --scopes=gadgets:read,gadgets:write" shop \
    >"$work/sock-writer.log" 2>&1 || true
  in_box "$askr_bin token:issue 1 reader --scopes=gadgets:read" shop \
    >"$work/sock-reader.log" 2>&1 || true
  wtok=$(grep -E '^  askr_' "$work/sock-writer.log" | tr -d ' ' | head -1)
  rtok=$(grep -E '^  askr_' "$work/sock-reader.log" | tr -d ' ' | head -1)
  if [ -z "$wtok" ] || [ -z "$rtok" ]; then
    bad "askr token:issue gives two tokens" "$(tail -4 "$work/sock-writer.log")"
    return 0
  fi
  ok "askr token:issue gives a token that may write and one that may only read"
  in_box "python3 -c \"import sqlite3; c=sqlite3.connect('storage/api.sqlite'); c.execute(\\\"insert into makers(name, created_at, updated_at) values('Acme', datetime('now'), datetime('now'))\\\"); c.execute(\\\"insert into tags(name, created_at, updated_at) values('Red', datetime('now'), datetime('now')), ('Blue', datetime('now'), datetime('now'))\\\"); c.commit()\"" \
    shop >/dev/null 2>&1 || true

  # A second language, read at start-up: the refusals below are asked for
  # in it, and lang:check has to say what it lacks.
  mkdir -p "$work/shop/lang"
  printf '[validation]\nrequired = ":attribute m\303\245 fylles ut"\n\n[validation.attributes]\nname = "navn"\n\n[lauf]\nsearch = "S\303\270k"\n' \
    > "$work/shop/lang/nb.toml"
  code_lc=0
  in_box "$askr_bin lang:check" shop >"$work/sock-langcheck.log" 2>&1 || code_lc=$?
  if [ "$code_lc" = "1" ] && grep -q "lang/nb.toml lacks validation.min_length.one -- nb picks one for 1" "$work/sock-langcheck.log"; then
    ok "askr lang:check says what nb lacks, and exits 1"
  else
    bad "askr lang:check says what nb lacks" "exit $code_lc: $(head -4 "$work/sock-langcheck.log")"
  fi

  docker rm -f askr-makecheck-api >/dev/null 2>&1
  docker run -d --name askr-makecheck-api -p "$api_port:$api_port" $DOCKER_PLATFORM \
    -v "$ROOT":/work -w "/work/${work#$ROOT/}/shop" "$IMAGE" \
    sh -c "./.build/bin/app $api_port 0.0.0.0" >/dev/null
  n=0
  until curl -s -o /dev/null "$base/openapi.json"; do
    n=$((n + 1))
    if [ $n -gt 80 ]; then
      bad "the app answers on a socket" "$(docker logs askr-makecheck-api 2>&1 | tail -3)"
      docker rm -f askr-makecheck-api >/dev/null 2>&1
      return 0
    fi
    sleep 0.25
  done

  J='Accept: application/json'
  code() { curl -s -o "$work/sock-body" -D "$work/sock-head" -w '%{http_code}' "$@"; }

  c=$(code -H "$J" "$base/api/gadgets")
  if [ "$c" = "401" ] && grep -qi '^www-authenticate: Bearer' "$work/sock-head"; then
    ok "no token: 401, with the challenge that says what to send"
  else
    bad "no token: 401 with WWW-Authenticate" "got $c: $(head -3 "$work/sock-head")"
  fi
  c=$(code -H "$J" -H "Authorization: Bearer $rtok" "$base/api/gadgets")
  [ "$c" = "200" ] && grep -q '"data":\[' "$work/sock-body" &&
    ok "a reader gets the list, in the envelope" ||
    bad "a reader gets the list" "got $c: $(head -c 200 "$work/sock-body")"
  c=$(code -H "$J" -H "Authorization: Bearer $rtok" -H 'Content-Type: application/json' \
        -d '{"name":"nope"}' "$base/api/gadgets")
  [ "$c" = "403" ] && grep -qi 'content-type: application/problem+json' "$work/sock-head" &&
    ok "and a 403 as a problem document when it tries to write" ||
    bad "a reader may not write" "got $c"

  # More refusals than the pool has connections, and then an ordinary
  # request. When a handler raised, the after-filters did not run, and
  # ReleaseDb is one: every 403 kept its connection.
  i=0
  while [ $i -lt 40 ]; do
    curl -s -o /dev/null -H "$J" -H "Authorization: Bearer $rtok" \
      -H 'Content-Type: application/json' -d '{}' "$base/api/gadgets"
    i=$((i + 1))
  done
  c=$(code -H "$J" -H "Authorization: Bearer $rtok" "$base/api/gadgets")
  [ "$c" = "200" ] &&
    ok "forty refusals later the pool still has a connection to give" ||
    bad "forty refusals later the pool still has a connection" "got $c: $(head -c 200 "$work/sock-body")"

  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -d '{"name":"Over a socket","born":"2026-01-02","maker_id":1,"qty":2}' "$base/api/gadgets")
  loc=$(grep -i '^location:' "$work/sock-head" | tr -d '\r' | sed 's/^[Ll]ocation: *//')
  if [ "$c" = "201" ] && [ -n "$loc" ]; then
    ok "a writer creates one: 201, and where it is"
  else
    bad "a writer creates one" "got $c: $(head -c 300 "$work/sock-body")"
  fi
  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -H 'Accept-Language: nb-NO,nb;q=0.9' -d '{"born":"2026-01-02","maker_id":1}' "$base/api/gadgets")
  if [ "$c" = "422" ] && grep -q 'navn må fylles ut' "$work/sock-body" &&
     grep -qi '^content-language: nb' "$work/sock-head"; then
    ok "asked in Norwegian, the refusal is in Norwegian, with the field's Norwegian name"
  else
    bad "the refusal is in the language asked for" "got $c: $(head -c 300 "$work/sock-body")"
  fi

  # Refused on the form, not by the database: before Exists and Unique a
  # key to nothing and a duplicate name were both a 500.
  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -d '{"name":"No maker","born":"2026-01-02","maker_id":999}' "$base/api/gadgets")
  [ "$c" = "422" ] && grep -q '"maker_id"' "$work/sock-body" &&
    ok "a maker that is not there is a 422 on maker_id, not a 500" ||
    bad "a maker that is not there is a 422" "got $c: $(head -c 200 "$work/sock-body")"
  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -d '{"name":"Over a socket","born":"2026-01-02","maker_id":1}' "$base/api/gadgets")
  [ "$c" = "422" ] && grep -q '"name"' "$work/sock-body" &&
    ok "and a name that is taken is a 422 on name" ||
    bad "a name that is taken is a 422" "got $c: $(head -c 200 "$work/sock-body")"

  # Tags over the wire: ids in, rows out, and a key left out is left alone.
  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -d '{"name":"Tagged","born":"2026-01-02","maker_id":1,"tag_ids":[1,2]}' "$base/api/gadgets")
  tloc=$(grep -i '^location:' "$work/sock-head" | tr -d '\r' | sed 's/^[Ll]ocation: *//')
  if [ "$c" = "201" ] && grep -q '"tags":\[{' "$work/sock-body" &&
     grep -q '"name":"Red"' "$work/sock-body" && grep -q '"name":"Blue"' "$work/sock-body"; then
    ok "one made with tag_ids answers with its tags"
  else
    bad "one made with tag_ids answers with its tags" "got $c: $(head -c 300 "$work/sock-body")"
  fi
  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -X PATCH -d '{"qty":4}' "$base$tloc")
  [ "$c" = "200" ] && grep -q '"name":"Blue"' "$work/sock-body" &&
    ok "a PATCH without tag_ids leaves them" ||
    bad "a PATCH without tag_ids leaves them" "got $c: $(head -c 300 "$work/sock-body")"
  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -X PATCH -d '{"tag_ids":[999]}' "$base$tloc")
  [ "$c" = "422" ] && grep -q '"tag_ids"' "$work/sock-body" &&
    ok "a tag that is not there is a 422 on tag_ids" ||
    bad "a tag that is not there is a 422" "got $c: $(head -c 300 "$work/sock-body")"
  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -X PATCH -d '{"tag_ids":[]}' "$base$tloc")
  [ "$c" = "200" ] && grep -q '"tags":\[\]' "$work/sock-body" &&
    ok "and an empty list takes them all off" ||
    bad "an empty list takes them all off" "got $c: $(head -c 300 "$work/sock-body")"

  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -H 'Content-Type: application/json' \
        -X PATCH -d '{"name":"Patched"}' "$base$loc")
  if [ "$c" = "200" ] && grep -q '"name":"Patched"' "$work/sock-body" &&
     grep -q '"qty":2' "$work/sock-body"; then
    ok "a PATCH changes what was sent and leaves the rest"
  else
    bad "a PATCH changes what was sent" "got $c: $(head -c 300 "$work/sock-body")"
  fi
  c=$(code -H "$J" -H "Authorization: Bearer $wtok" -X DELETE "$base$loc")
  size=$(wc -c < "$work/sock-body" | tr -d ' ')
  [ "$c" = "204" ] && [ "$size" = "0" ] &&
    ok "a delete is 204, with nothing in it" || bad "a delete is 204" "got $c, $size bytes"
  c=$(code -H "$J" -H "Authorization: Bearer $rtok" "$base$loc")
  [ "$c" = "404" ] && ok "and then it is a 404" || bad "and then it is a 404" "got $c"
  c=$(code "$base/openapi.json")
  [ "$c" = "200" ] && grep -q '"/api/gadgets/{id}"' "$work/sock-body" &&
    ok "/openapi.json describes it, from what is running" ||
    bad "/openapi.json describes it" "got $c"

  docker rm -f askr-makecheck-api >/dev/null 2>&1
}

make_check_browser() {
  chrome=${ASKR_CHROME:-"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"}
  [ -x "$chrome" ] || chrome=$(command -v google-chrome || command -v chromium || true)
  if ! command -v node >/dev/null 2>&1 || [ -z "$chrome" ] || [ ! -x "$chrome" ]; then
    skip "needs node and Chrome (ASKR_CHROME)"
    return 0
  fi
  if [ ! -d "$ROOT/frontend/lauf/node_modules/axe-core" ]; then
    skip "needs npm install in frontend/lauf"
    return 0
  fi
  web_port=${ASKR_MAKE_PORT:-8353}
  front="$work/shop/frontend"
  # The scaffold was made in the container, so Lauf is file:/work/...; on
  # the host it is this checkout.
  sed -i.bak "s|\"file:/work/frontend/lauf\"|\"file:$ROOT/frontend/lauf\"|" "$front/package.json"
  rm -f "$front/package.json.bak"
  if ! ( cd "$front" && npm install --no-fund --no-audit >"$work/web-npm.log" 2>&1 ); then
    skip "npm install failed (see $work/web-npm.log)"
    return 0
  fi
  if curl -s -o /dev/null "http://127.0.0.1:5173/" 2>/dev/null; then
    skip "something is already on port 5173, where the pages load Vite from"
    return 0
  fi
  ( cd "$front" && exec npx vite --host 127.0.0.1 ) >"$work/web-vite.log" 2>&1 &
  vite_pid=$!
  printf 'APP_ENV=local\nDATABASE_URL=sqlite:storage/browser.sqlite\n' > "$work/shop/.env"
  in_box "rm -f storage/browser.sqlite && $askr_bin migrate" shop >"$work/web-migrate.log" 2>&1 || true
  docker rm -f askr-makecheck-web >/dev/null 2>&1
  docker run -d --name askr-makecheck-web -p "$web_port:$web_port" $DOCKER_PLATFORM \
    -v "$ROOT":/work -w "/work/${work#$ROOT/}/shop" "$IMAGE" \
    sh -c "./.build/bin/app $web_port 0.0.0.0" >/dev/null
  profile=$(mktemp -d)
  "$chrome" --headless --disable-gpu --remote-debugging-port=9224 \
    --user-data-dir="$profile" about:blank >/dev/null 2>&1 &
  chrome_pid=$!
  n=0
  until curl -s -o /dev/null "http://127.0.0.1:9224/json/list" &&
        curl -s -o /dev/null "http://localhost:$web_port/gadgets" &&
        curl -s -o /dev/null "http://127.0.0.1:5173/build/src/main.js"; do
    n=$((n + 1))
    if [ $n -gt 80 ]; then
      bad "the app, Vite and Chrome start" "$(docker logs askr-makecheck-web 2>&1 | tail -3)"
      break
    fi
    sleep 0.25
  done
  if [ $n -le 80 ]; then
    if BASE="http://localhost:$web_port" CDP=http://127.0.0.1:9224 \
         node "$ROOT/tools/make-check/axe.mjs" >"$work/web-axe-empty.log" 2>&1; then
      ok "axe finds nothing on the empty lists and the new forms ($(grep -c '^  ok' "$work/web-axe-empty.log") pages)"
    else
      bad "axe finds nothing on the empty lists" "$(grep -E 'FAIL' -A2 "$work/web-axe-empty.log" | head -14)"
    fi
    if BASE="http://localhost:$web_port" CDP=http://127.0.0.1:9224 \
         node "$ROOT/tools/make-check/browser.mjs" >"$work/web-browser.log" 2>&1; then
      ok "create, show, edit, refuse, list, search, sort and delete, in Chrome ($(grep -c '^  ok' "$work/web-browser.log") checks)"
    else
      bad "the pages work in Chrome" "$(grep -E 'FAIL|got|Error|errors' -A1 "$work/web-browser.log" | head -14)"
    fi
    if AXE_EXPECT_ROWS=1 BASE="http://localhost:$web_port" CDP=http://127.0.0.1:9224 \
         node "$ROOT/tools/make-check/axe.mjs" >"$work/web-axe.log" 2>&1; then
      ok "and with rows, their pages and their forms: contrast included, light and dark, 1280 and 390 px ($(grep -c '^  ok' "$work/web-axe.log") pages)"
    else
      bad "axe finds nothing on the pages" "$(grep -E 'FAIL' -A2 "$work/web-axe.log" | head -14)"
    fi
  fi
  kill "$vite_pid" "$chrome_pid" 2>/dev/null
  wait "$vite_pid" "$chrome_pid" 2>/dev/null
  docker rm -f askr-makecheck-web >/dev/null 2>&1
  rm -rf "$profile" 2>/dev/null
}

# The gate behind docs/generators.md: what `askr make` writes has to build,
# migrate, round-trip, test, describe itself and work in a browser, on all
# three databases. In order:
#
#   make model      every type, refusals, the round trip through the model
#   the plan        each table read back gives the lines make model wrote
#   make resource   three of them, --api on two; built, tested on SQLite,
#                   Postgres and MySQL; openapi --check and a validator
#   a socket        the API with real tokens and curl, and the pool after
#                   forty refusals
#   a browser       the pages in Chrome, and axe over every one of them
#   the migrator    two migrations with one version
#
# Needs ./askr db:up. The socket and the browser need node and Chrome;
# without them those parts are skipped, counted, and the last line says so
# instead of claiming them.
cmd_make_check() {
  prepare
  fail=0
  oks=0
  fails=0
  skips=0
  started=$(date +%s)
  ok()   { echo "  ok    $1"; oks=$((oks + 1)); }
  bad()  { echo "  FAIL  $1"; shift; [ $# -gt 0 ] && printf '        %s\n' "$@"; fail=1; fails=$((fails + 1)); }
  skip() { echo "  skip  $1"; skips=$((skips + 1)); }

  if ! docker ps --format '{{.Names}}' | grep -qx askr-postgres ||
     ! docker ps --format '{{.Names}}' | grep -qx askr-mysql; then
    echo "make:check needs Postgres and MySQL. Run: ./askr db:up" >&2
    return 1
  fi
  ensure_image

  mk_bin="$BUILD/makecheck-bin"
  mk_units="$BUILD/makecheck-units"
  work="$BUILD/makecheck"
  mkdir -p "$mk_bin" "$mk_units" "$work"
  flags=$(echo "$FPCFLAGS" | sed "s|-FU$UNITS|-FU$mk_units|; s|-FE$BIN|-FE$mk_bin|" |
          sed "s|$ROOT|/work|g" | sed 's/-WM11.0//')

  in_box() {
    docker run --rm --network "$DB_NET" $DOCKER_PLATFORM -v "$ROOT":/work \
      -e ASKR_HOME=/work -w "/work/${work#$ROOT/}${2:+/$2}" "$IMAGE" sh -c "$1"
  }
  askr_bin="/work/${mk_bin#$ROOT/}/askr"

  echo "Building the askr tool for the container ..."
  if ! docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
       fpc $flags cli/askr.lpr >"$work/cli.log" 2>&1; then
    bad "the tool builds" "$(grep -iE 'error|fatal' "$work/cli.log" | head -3)"
    return 1
  fi
  if ! docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
       fpc $flags tools/make-check/plancheck.lpr >"$work/plancheck.log" 2>&1; then
    bad "the plan check builds" "$(grep -iE 'error|fatal' "$work/plancheck.log" | head -3)"
    return 1
  fi

  echo
  echo "- askr make model, from a spec"

  # The removal happens in the same container as the scaffold -- Docker
  # Desktop's mount cache does not always see a host-side delete in time.
  out=$(in_box "rm -rf shop && $askr_bin new shop --no-auth" 2>&1) || true
  if [ ! -f "$work/shop/askr.toml" ]; then
    bad "a project is scaffolded" "$(echo "$out" | tail -3)"
    return 1
  fi
  sed -i.bak 's|^version = .*|path = "/work"|; s|^path = .*|path = "/work"|' "$work/shop/askr.toml"
  rm -f "$work/shop/askr.toml.bak"
  ok "a project is scaffolded"

  if in_box "$askr_bin make model Maker 'name:string(80):unique'" shop >"$work/m1.log" 2>&1; then
    ok "a parent model"
  else
    bad "a parent model" "$(tail -3 "$work/m1.log")"
  fi

  # Quoted one by one: a bracket and a question mark both mean something to
  # a shell, and the spec has to arrive as it was written.
  spec="'name:string(60):unique' 'notes:text?' qty:int big:bigint active:bool price:money ratio:float 'seen_at:datetime?' born:date 'meta:json?' 'tag:uuid?' maker:references"
  if in_box "$askr_bin make model Gadget $spec" shop >"$work/m2.log" 2>&1; then
    ok "a model with every type there is"
  else
    bad "a model with every type there is" "$(tail -5 "$work/m2.log")"
  fi
  if grep -q "askr migrate" "$work/m2.log"; then
    ok "and it says what to run next, rather than migrating by itself"
  else
    bad "and it says what to run next" "$(cat "$work/m2.log")"
  fi

  # **Never over a file that is there.** The first `make` wrote it; the
  # second must not touch it, byte for byte, and must say so.
  before=$(cat "$work/shop/app/Models/App.Models.Gadget.pas" | cksum)
  if in_box "$askr_bin make model Gadget name:text" shop >"$work/m3.log" 2>&1; then
    bad "making it again is refused" "it exited 0"
  else
    ok "making it again is refused"
  fi
  after=$(cat "$work/shop/app/Models/App.Models.Gadget.pas" | cksum)
  if [ "$before" = "$after" ]; then
    ok "and the file is left exactly as it was"
  else
    bad "and the file is left exactly as it was"
  fi
  if grep -q "already there" "$work/m3.log"; then
    ok "and it says which file"
  else
    bad "and it says which file" "$(cat "$work/m3.log")"
  fi

  # A typo is not a type.
  if in_box "$askr_bin make model Thing name:strng" shop >"$work/m4.log" 2>&1; then
    bad "an unknown type is refused" "it exited 0"
  else
    ok "an unknown type is refused"
  fi
  if [ -f "$work/shop/app/Models/App.Models.Thing.pas" ]; then
    bad "and nothing was written"
  else
    ok "and nothing was written"
  fi

  cp "$ROOT/tools/make-check/roundtrip.lpr" "$work/shop/tests/app_tests.lpr" 2>/dev/null ||
    { mkdir -p "$work/shop/tests" && cp "$ROOT/tools/make-check/roundtrip.lpr" "$work/shop/tests/app_tests.lpr"; }

  # One database each, made fresh, so this never touches askr_dev.
  docker exec askr-postgres psql -q -U askr -d askr_dev \
    -c "DROP DATABASE IF EXISTS askr_make" -c "CREATE DATABASE askr_make" >/dev/null
  docker exec askr-mysql mysql -uroot -paskr -e \
    "DROP DATABASE IF EXISTS askr_make; CREATE DATABASE askr_make CHARACTER SET utf8mb4; GRANT ALL ON askr_make.* TO 'askr'@'%';" \
    2>/dev/null

  # Once: the migrations are compiled into the binary, so it has to be
  # built after make model and before anything runs them.
  echo
  if in_box "$askr_bin build" shop >"$work/build.log" 2>&1; then
    ok "the project builds with what make model wrote"
  else
    bad "the project builds with what make model wrote" \
      "$(grep -E 'rror|Fatal' "$work/build.log" | head -6)"
    return 1
  fi

  for dsn in \
      "sqlite:storage/make.sqlite" \
      "postgresql://askr:askr@askr-postgres:5432/askr_make" \
      "mysql://askr:askr@askr-mysql:3306/askr_make"; do
    dialect=${dsn%%:*}
    echo
    echo "- the round trip on $dialect"
    printf 'APP_ENV=local\nDATABASE_URL=%s\n' "$dsn" > "$work/shop/.env"
    in_box "rm -f storage/make.sqlite" shop >/dev/null 2>&1 || true

    if in_box "$askr_bin migrate" shop >"$work/migrate-$dialect.log" 2>&1; then
      ok "the migrations run"
    else
      bad "the migrations run" "$(tail -5 "$work/migrate-$dialect.log")"
      continue
    fi
    if in_box "$askr_bin test" shop >"$work/test-$dialect.log" 2>&1; then
      ok "every column comes back as it went in"
    else
      bad "every column comes back as it went in" \
        "$(grep -E 'FAIL|got:|rror' "$work/test-$dialect.log" | head -12)"
    fi
    # The other direction: the table, read back into a plan, gives the
    # spec that made it. Run by the framework's program, not the app's.
    if in_box "DATABASE_URL='$dsn' /work/${mk_bin#$ROOT/}/plancheck Gadget $spec" shop \
         >"$work/plan-$dialect.log" 2>&1; then
      ok "the table reads back as the spec that made it"
    else
      bad "the table reads back as the spec that made it" \
        "$(grep -E 'FAIL|got:|rror' "$work/plan-$dialect.log" | head -12)"
    fi
  done

  echo
  echo "- askr make resource"

  # A table with no model, written by hand the way a person would: a
  # keyword for a column name, a secret, a default, soft deletes. make
  # resource has to write the model for this one; for Gadget it uses the
  # one make model wrote.
  cat > "$work/shop/database/App.Migrations.CreateNotes.pas" <<'EOF'
unit App.Migrations.CreateNotes;

{$mode Delphi}{$H+}

interface

uses
  Askr.Norn.Schema, Askr.Norn.Migration;

type
  TCreateNotes = class(TMigration)
  public
    class function Version: string; override;
    procedure Up(S: TSchemaBuilder); override;
  end;

implementation

class function TCreateNotes.Version: string;
begin
  Result := '29990101000000';
end;

procedure TCreateNotes.Up(S: TSchemaBuilder);
begin
  with S.Create('notes') do
  begin
    Id;
    Text('title', 80);
    Text('type', 20).Nullable;
    Text('status', 20).Default('draft');
    Text('api_token', 64).Nullable;
    Bool('pinned').Default(False);
    { Unique numbers: their samples in the generated test have to fit an
      INTEGER and a NUMERIC(12,2) on Postgres and MySQL. }
    Int('rank').Nullable.Unique;
    Money('fee').Nullable.Unique;
    Timestamps;
    SoftDeletes;
  end;
end;

initialization
  RegisterMigration(TCreateNotes);

end.
EOF
  # make migration regenerates the index, which puts CreateNotes in it.
  # The round trip's tests go: make resource writes the test program.
  in_box "rm -f storage/resource.sqlite tests/app_tests.lpr && $askr_bin make migration Noop2" \
    shop >/dev/null 2>&1 || true

  # A pivot: tags, and the table between them and gadgets. The relation
  # goes into the Gadget model make model wrote, line for line as make
  # pivot says -- which is the check that what it prints is right.
  if in_box "$askr_bin make model Tag 'name:string(40):unique' && $askr_bin make pivot Gadget Tag" \
       shop >"$work/pivot.log" 2>&1; then
    ok "make model Tag, and make pivot Gadget Tag"
  else
    bad "make model Tag, and make pivot Gadget Tag" "$(tail -6 "$work/pivot.log")"
  fi
  if grep -qF "uses       App.Models.Tag, and Askr.Urd.Query where TModelList is not in scope yet" "$work/pivot.log" &&
     grep -qF "type       TTagList = TModelList<TTag>;" "$work/pivot.log" &&
     grep -qF "published  Tags: TTagList;" "$work/pivot.log" &&
     grep -qF "Describe   S.BelongsToMany('Tags', TTag);" "$work/pivot.log"; then
    ok "and it prints what the model needs"
  else
    bad "and it prints what the model needs" "$(tail -12 "$work/pivot.log")"
  fi
  if python3 - "$work/shop/app/Models/App.Models.Gadget.pas" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
for old, new in [
    ("  SysUtils, Askr.Urd.Model;", "  SysUtils, Askr.Urd.Model, App.Models.Tag, Askr.Urd.Query;"),
    ("\ntype\n", "\ntype\n  TTagList = TModelList<TTag>;\n\n"),
    ("  published\n", "  published\n    Tags: TTagList;\n"),
    ("  S.Table('gadgets');\n", "  S.Table('gadgets');\n  S.BelongsToMany('Tags', TTag);\n"),
]:
    if s.count(old) != 1:
        sys.exit('no single place for: ' + old.strip())
    s = s.replace(old, new, 1)
open(p, 'w').write(s)
PY
  then
    ok "which go where it says"
  else
    bad "the lines go into the Gadget model"
  fi
  printf 'APP_ENV=local\nDATABASE_URL=sqlite:storage/resource.sqlite\n' > "$work/shop/.env"
  if ! in_box "$askr_bin build && $askr_bin migrate" shop >"$work/res-migrate.log" 2>&1; then
    bad "the project migrates before make resource" "$(grep -E 'rror|Fatal' "$work/res-migrate.log" | head -5)"
    return 1
  fi

  # Tag first, so the gadget's page can link to the tags' pages.
  for model in Tag Gadget Maker Note; do
    if in_box "$askr_bin make resource $model" shop >"$work/res-$model.log" 2>&1; then
      ok "make resource $model"
    else
      bad "make resource $model" "$(tail -6 "$work/res-$model.log")"
    fi
  done
  if grep -q "App.Models.Gadget.pas, which is there" "$work/res-Gadget.log"; then
    ok "it uses the model make model wrote, and does not rewrite it"
  else
    bad "it uses the model make model wrote" "$(head -20 "$work/res-Gadget.log")"
  fi
  if [ -f "$work/shop/app/Models/App.Models.Note.pas" ]; then
    ok "and writes one for a table that had none"
  else
    bad "and writes one for a table that had none"
  fi
  if grep -q "belongs to many Tags (TTag) through gadget_tag, as tag_ids" "$work/res-Gadget.log" &&
     ! grep -q "left off the form" "$work/res-Gadget.log"; then
    ok "gadgets belong to many tags, with the boxes on the form"
  else
    bad "gadgets belong to many tags" "$(grep -E 'many|left off' "$work/res-Gadget.log" | head -4)"
  fi
  if grep -q "cannot use each other" "$work/res-Tag.log"; then
    ok "and tags say why they cannot have boxes for gadgets too"
  else
    bad "tags say why they have no boxes for gadgets" "$(tail -8 "$work/res-Tag.log")"
  fi
  if in_box "$askr_bin make resource GadgetTag --table=gadget_tag" shop >"$work/res-pivot.log" 2>&1; then
    bad "the pivot is refused as a resource" "it exited 0"
  else
    grep -q "is the pivot between gadgets and tags" "$work/res-pivot.log" &&
      ok "the pivot is refused as a resource, saying what it is" ||
      bad "the pivot is refused, saying what it is" "$(cat "$work/res-pivot.log")"
  fi

  before=$(cksum < "$work/shop/app/Http/App.Http.GadgetsController.pas")
  if in_box "$askr_bin make resource Gadget" shop >"$work/res-again.log" 2>&1; then
    bad "making it again is refused" "it exited 0"
  else
    ok "making it again is refused"
  fi
  after=$(cksum < "$work/shop/app/Http/App.Http.GadgetsController.pas")
  [ "$before" = "$after" ] && ok "and the controller is left exactly as it was" ||
    bad "and the controller is left exactly as it was"
  # grep -c exits 1 on a count of 0, and under set -e the whole gate then
  # died here without a word -- exactly when it had something to say.
  n_routes=$(grep -c 'GadgetsRoutes(R);' "$work/shop/app.lpr" || true)
  [ "$n_routes" = "1" ] && ok "and the routes are in app.lpr once" ||
    bad "and the routes are in app.lpr once" "found $n_routes"

  if in_box "$askr_bin make resource Widget" shop >"$work/res-none.log" 2>&1; then
    bad "a table that is not there is refused" "it exited 0"
  else
    ok "a table that is not there is refused"
  fi
  if grep -q "widgets" "$work/res-none.log" && grep -q "gadgets" "$work/res-none.log"; then
    ok "and it says which it looked for, and which there are"
  else
    bad "and it says which it looked for" "$(cat "$work/res-none.log")"
  fi
  [ -f "$work/shop/app/Http/App.Http.WidgetsController.pas" ] &&
    bad "and nothing was written" || ok "and nothing was written"

  echo
  echo "- askr make resource --api"
  # On top of the pages: the same tables as JSON, which is the case a real
  # app is in -- and the one where app.lpr already has a resource in it.
  for model in Gadget Note; do
    if in_box "$askr_bin make resource $model --api" shop >"$work/res-api-$model.log" 2>&1; then
      ok "make resource $model --api"
    else
      bad "make resource $model --api" "$(tail -6 "$work/res-api-$model.log")"
    fi
  done
  n_doc=$(grep -c 'UseOpenApi(R, @AppApiDoc);' "$work/shop/app.lpr" || true)
  [ "$n_doc" = "1" ] && ok "UseOpenApi is in app.lpr once, for two of them" ||
    bad "UseOpenApi is in app.lpr once" "found $n_doc"
  if grep -q 'GadgetsApiDoc(D);' "$work/shop/app/Http/App.Http.ApiDoc.pas" &&
     grep -q 'NotesApiDoc(D);' "$work/shop/app/Http/App.Http.ApiDoc.pas"; then
    ok "and the document describes both"
  else
    bad "and the document describes both" "$(cat "$work/shop/app/Http/App.Http.ApiDoc.pas" 2>&1 | tail -8)"
  fi
  if in_box "$askr_bin make resource Gadget --api" shop >"$work/res-api-again.log" 2>&1; then
    bad "making the API again is refused" "it exited 0"
  else
    ok "making the API again is refused"
  fi

  echo
  if in_box "$askr_bin build" shop >"$work/res-build.log" 2>&1; then
    ok "the project builds with the four resources in it"
  else
    bad "the project builds with the four resources in it" \
      "$(grep -E 'rror|Fatal' "$work/res-build.log" | head -8)"
    return 1
  fi
  if grep -iE 'warning' "$work/res-build.log" | grep -E 'Controller|App.Models.Note|App.Tests' >/dev/null; then
    bad "and what it wrote compiles without a warning" \
      "$(grep -iE 'warning' "$work/res-build.log" | grep -E 'Controller|App.Models.Note|App.Tests' | head -5)"
  else
    ok "and what it wrote compiles without a warning"
  fi

  # The generated tests, on the database they default to and then on the
  # two servers. TEST_DATABASE_URL is theirs, so this is the path a user
  # takes too.
  for tdsn in \
      "" \
      "postgresql://askr:askr@askr-postgres:5432/askr_make" \
      "mysql://askr:askr@askr-mysql:3306/askr_make"; do
    label=${tdsn%%:*}
    [ -z "$tdsn" ] && label="sqlite::memory:"
    if in_box "TEST_DATABASE_URL='$tdsn' $askr_bin test" shop >"$work/res-test-${label%%:*}.log" 2>&1; then
      ok "the generated tests pass on $label"
    else
      bad "the generated tests pass on $label" \
        "$(grep -E 'FAIL|got|expected|rror' "$work/res-test-${label%%:*}.log" | head -12)"
    fi
  done
  # The document, straight after generation: no drift, and valid to a
  # validator that is not ours. A resource whose description disagreed
  # with its routes would be the generator lying on the first run.
  if in_box "$askr_bin openapi --check" shop >"$work/res-drift.log" 2>&1; then
    ok "askr openapi --check finds no drift, straight after make"
  else
    bad "askr openapi --check finds no drift" "$(head -8 "$work/res-drift.log")"
  fi
  if in_box "$askr_bin openapi" shop >"$work/res-openapi.json" 2>"$work/res-openapi.err"; then
    if grep -q '"api_token"' "$work/res-openapi.json"; then
      bad "the document does not name the secret"
    else
      ok "the document does not name the secret"
    fi
    if command -v node >/dev/null 2>&1; then
      if [ ! -d "$ROOT/tools/openapi/node_modules" ]; then
        ( cd "$ROOT/tools/openapi" &&
          npm install --silent --no-fund --no-audit ) >/dev/null 2>&1 || true
      fi
      out=$(cd "$ROOT" && node tools/openapi/validate.mjs "$work/res-openapi.json" 2>&1) &&
        ok "a real validator accepts it: ${out#ok: }" ||
        bad "a real validator accepts it" "$out"
    else
      skip "the validator: node is not here"
    fi
  else
    bad "askr openapi prints the document" "$(head -5 "$work/res-openapi.err")"
  fi

  count=$(grep -c '^    ok' "$work/res-test-sqlite.log" 2>/dev/null || echo 0)
  if [ "$count" -ge 32 ]; then
    ok "and they are all there: $count"
  else
    bad "and they are all there" "only $count ran"
  fi

  # The pages compile, and import nothing Lauf does not export. Svelte is
  # not typed against the table, so this is as far as a gate can see
  # without a browser.
  if command -v node >/dev/null 2>&1 && [ -d "$ROOT/frontend/lauf/node_modules/svelte" ]; then
    if node "$ROOT/tools/make-check/pages.mjs" "$work/shop/frontend/src/pages" \
         >"$work/res-pages.log" 2>&1; then
      ok "the pages compile, and every import is one Lauf has"
    else
      bad "the pages compile" "$(head -12 "$work/res-pages.log")"
    fi
  else
    skip "the pages: needs node and npm install in frontend/lauf"
  fi

  echo
  echo "- the API over a socket"
  make_check_socket

  echo
  echo "- the pages in a browser"
  make_check_browser
  echo
  echo "- commands of the app's own"
  make_check_commands

  echo
  echo "- two migrations with one version"

  # Written by hand, with the version of one that is there. make model can
  # no longer produce this, but a person can -- and before the migrator
  # checked, it ran the second one's DDL and then failed to record it.
  ver=$(sed -n "s/.*Result := '\([0-9]\{14\}\)'.*/\1/p" \
    "$work/shop/database/App.Migrations.CreateMakers.pas" | head -1)
  cat > "$work/shop/database/App.Migrations.Twin.pas" <<EOF
unit App.Migrations.Twin;

{\$mode Delphi}{\$H+}

interface

uses
  Askr.Norn.Schema, Askr.Norn.Migration;

type
  TTwin = class(TMigration)
  public
    class function Version: string; override;
    procedure Up(S: TSchemaBuilder); override;
  end;

implementation

class function TTwin.Version: string;
begin
  Result := '$ver';
end;

procedure TTwin.Up(S: TSchemaBuilder);
begin
  with S.Create('twins') do
    Id;
end;

initialization
  RegisterMigration(TTwin);

end.
EOF
  # make migration regenerates the index from the directory, which is what
  # puts the hand-written one in it -- the way a person would.
  in_box "$askr_bin make migration Noop" shop >/dev/null 2>&1 || true
  printf 'APP_ENV=local\nDATABASE_URL=sqlite:storage/twin.sqlite\n' > "$work/shop/.env"
  in_box "rm -f storage/twin.sqlite" shop >/dev/null 2>&1 || true
  if ! in_box "$askr_bin build" shop >"$work/twin-build.log" 2>&1; then
    bad "the project with the twin builds" "$(grep -E 'rror|Fatal' "$work/twin-build.log" | head -4)"
  elif in_box "$askr_bin migrate" shop >"$work/twin.log" 2>&1; then
    bad "askr migrate refuses two migrations with one version" "it exited 0"
  else
    ok "askr migrate refuses two migrations with one version"
    if grep -q TTwin "$work/twin.log" && grep -q TCreateMakers "$work/twin.log"; then
      ok "and names both of them"
    else
      bad "and names both of them" "$(grep -v '^  \$' "$work/twin.log" | head -4)"
    fi
    # As a sentence, not as a crash. An exception nobody caught prints
    # "An unhandled exception occurred at $..." and a column of addresses,
    # which reads as the tool breaking rather than as something to fix.
    if grep -q 'unhandled exception\|^  \$0000' "$work/twin.log"; then
      bad "and says it as a message, not as a stack of addresses" \
        "$(head -3 "$work/twin.log")"
    else
      ok "and says it as a message, not as a stack of addresses"
    fi
    tables=$(in_box "python3 -c \"import sqlite3; print(' '.join(r[0] for r in sqlite3.connect('storage/twin.sqlite').execute(\\\"select name from sqlite_master where type='table'\\\")))\"" shop 2>/dev/null)
    case " $tables " in
      *" makers "*|*" twins "*)
        bad "and nothing was run before it said so" "tables: $tables" ;;
      *)
        ok "and nothing was run before it said so" ;;
    esac
  fi

  echo
  took=$(( $(date +%s) - started ))
  if [ $fail -ne 0 ]; then
    echo "make:check failed: $fails of $((oks + fails)) checks, in ${took}s."
    return 1
  fi
  if [ $skips -eq 0 ]; then
    echo "make:check holds: $oks checks in ${took}s -- what askr make writes builds, migrates,"
    echo "round-trips and passes its own tests on SQLite, Postgres and MySQL, describes"
    echo "itself without drift, answers over a socket, and works in Chrome."
  else
    echo "make:check holds for what ran: $oks checks in ${took}s, $skips skipped (see above)."
    echo "What was skipped has not been shown to work here."
  fi
}

# The gate for sessions in the database. Written in English like
# cmd_mcp_check.
#
# Two app processes on one database are two nodes. A login on one has
# to be a login on the other, and a logout on the other has to end it on
# the first. The same scenario runs once with the memory driver, where
# the second node must NOT know the visitor -- without that control, a
# green run could be a gate that cannot see the difference.
cmd_session_check() {
  prepare
  fail=0
  ok()   { echo "  ok    $1"; }
  bad()  { echo "  FAIL  $1"; shift; [ $# -gt 0 ] && printf '        %s\n' "$@"; fail=1; }

  if ! docker ps --format '{{.Names}}' | grep -qx askr-postgres ||
     ! docker ps --format '{{.Names}}' | grep -qx askr-mysql; then
    echo "session:check needs Postgres and MySQL. Run: ./askr db:up" >&2
    return 1
  fi
  ensure_image

  sc_bin="$BUILD/sessioncheck-bin"
  sc_units="$BUILD/sessioncheck-units"
  work="$BUILD/sessioncheck"
  mkdir -p "$sc_bin" "$sc_units" "$work"
  flags=$(echo "$FPCFLAGS" | sed "s|-FU$UNITS|-FU$sc_units|; s|-FE$BIN|-FE$sc_bin|" |
          sed "s|$ROOT|/work|g" | sed 's/-WM11.0//')
  in_box() {
    docker run --rm --network "$DB_NET" $DOCKER_PLATFORM -v "$ROOT":/work \
      -e ASKR_HOME=/work -w "/work/${work#$ROOT/}${2:+/$2}" "$IMAGE" sh -c "$1"
  }
  askr_bin="/work/${sc_bin#$ROOT/}/askr"

  echo "Building the askr tool for the container ..."
  if ! docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
       fpc $flags cli/askr.lpr >"$work/cli.log" 2>&1; then
    bad "the tool builds" "$(grep -iE 'error|fatal' "$work/cli.log" | head -3)"
    return 1
  fi

  # Removed in the same container that scaffolds: Docker Desktop's mount
  # cache does not always see a host-side delete in time.
  out=$(in_box "rm -rf site && $askr_bin new site --auth" 2>&1) || true
  if [ ! -f "$work/site/askr.toml" ]; then
    bad "a project with sign-in is scaffolded" "$(echo "$out" | tail -3)"
    return 1
  fi
  sed -i.bak 's|^version = .*|path = "/work"|; s|^path = .*|path = "/work"|' "$work/site/askr.toml"
  rm -f "$work/site/askr.toml.bak"
  if in_box "$askr_bin build" site >"$work/build.log" 2>&1; then
    ok "a project with sign-in is scaffolded and builds"
  else
    bad "the project builds" "$(grep -E 'rror|Fatal' "$work/build.log" | head -6)"
    return 1
  fi

  docker exec askr-postgres psql -q -U askr -d askr_dev \
    -c "DROP DATABASE IF EXISTS askr_sess" -c "CREATE DATABASE askr_sess" >/dev/null
  docker exec askr-mysql mysql -uroot -paskr -e \
    "DROP DATABASE IF EXISTS askr_sess; CREATE DATABASE askr_sess CHARACTER SET utf8mb4; GRANT ALL ON askr_sess.* TO 'askr'@'%';" \
    2>/dev/null

  port_a=${ASKR_SESSION_PORT_A:-8361}
  port_b=${ASKR_SESSION_PORT_B:-8362}
  a="http://127.0.0.1:$port_a"
  b="http://127.0.0.1:$port_b"
  cname=askr-sessioncheck

  # Both processes in one container: two processes share no memory, which
  # is the property, and one container keeps a SQLite file on one kernel.
  start_nodes() {
    docker rm -f $cname >/dev/null 2>&1
    docker run -d --name $cname --network "$DB_NET" $DOCKER_PLATFORM \
      -p "$port_a:$port_a" -p "$port_b:$port_b" \
      -e SESSION_DRIVER="$2" -e DATABASE_URL="$1" \
      -v "$ROOT":/work -w "/work/${work#$ROOT/}/site" "$IMAGE" \
      sh -c "./.build/bin/app $port_a 0.0.0.0 & ./.build/bin/app $port_b 0.0.0.0 & wait" >/dev/null
    n=0
    until curl -s -o /dev/null "$a/login" && curl -s -o /dev/null "$b/login"; do
      n=$((n + 1))
      if [ $n -gt 80 ]; then
        bad "both nodes answer" "$(docker logs $cname 2>&1 | tail -4)"
        return 1
      fi
      sleep 0.25
    done
  }
  token_in() { grep -o 'name="_token" value="[^"]*"' "$1" | head -1 | sed 's/.*value="//; s/"$//'; }
  # Never a non-zero exit: under set -e a refused connection would end
  # the whole gate without a word. curl says 000 instead, which fails
  # the check it was for.
  status() { curl -s -o "$work/body" -w '%{http_code}' -b "$jar" -c "$jar" "$@" || true; }

  # Signs in on A. Leaves the session in $jar.
  sign_up_on_a() {
    jar="$work/jar-$1"
    rm -f "$jar"
    status "$a/register" >/dev/null
    tok=$(token_in "$work/body")
    c=$(status --data-urlencode "_token=$tok" --data-urlencode "name=Ada $1" \
          --data-urlencode "email=ada-$1-$(date +%s)@example.com" \
          --data-urlencode "password=correct-horse-battery" \
          --data-urlencode "password_confirmation=correct-horse-battery" \
          "$a/register")
    [ "$c" = "303" ]
  }

  for dsn in \
      "sqlite:storage/sessions.sqlite" \
      "postgresql://askr:askr@askr-postgres:5432/askr_sess" \
      "mysql://askr:askr@askr-mysql:3306/askr_sess"; do
    dialect=${dsn%%:*}
    echo
    echo "- $dialect"
    [ "$dialect" = sqlite ] && rm -f "$work/site/storage/sessions.sqlite"*
    if ! in_box "DATABASE_URL='$dsn' ./.build/bin/app --migrate" site >"$work/migrate-$dialect.log" 2>&1; then
      bad "migrate" "$(tail -3 "$work/migrate-$dialect.log")"
      continue
    fi
    start_nodes "$dsn" database || continue

    if sign_up_on_a "$dialect"; then
      ok "signed up and in on node A"
    else
      bad "signed up and in on node A" "got $c: $(head -c 300 "$work/body")"
      docker rm -f $cname >/dev/null 2>&1
      continue
    fi
    # The profile, not the dashboard: the dashboard wants a confirmed
    # address, and a new account has none. The profile needs only the
    # sign-in, which is what is being shared.
    c=$(status "$b/settings/profile")
    if [ "$c" = "200" ] && grep -q "Ada $dialect" "$work/body"; then
      ok "node B knows who it is"
    else
      bad "node B knows who it is" "got $c: $(head -c 200 "$work/body")"
    fi

    # What is in the table: the hash of the cookie, never the cookie.
    # Each query ends in || true: with no table -- a store that never
    # wrote one -- set -e would otherwise stop the gate here, after one
    # database, with the failure above as the last word.
    cookie=$(awk '$6 == "askr_session" { print $7 }' "$jar" | tail -1)
    hash=$(printf '%s' "$cookie" | shasum -a 256 | cut -d' ' -f1)
    case $dialect in
      sqlite)
        rows=$(in_box "python3 -c \"import sqlite3; c=sqlite3.connect('storage/sessions.sqlite'); print('\\\\n'.join(r[0]+' '+r[1] for r in c.execute('select id_hash, payload from askr_sessions')))\"" site 2>&1 || true) ;;
      postgresql)
        rows=$(docker exec askr-postgres psql -At -U askr -d askr_sess \
                 -c "select id_hash || ' ' || payload from askr_sessions" 2>&1 || true) ;;
      mysql)
        rows=$(docker exec askr-mysql mysql -N -uaskr -paskr askr_sess \
                 -e "select concat(id_hash, ' ', payload) from askr_sessions" 2>/dev/null || true) ;;
    esac
    if [ ${#cookie} -eq 32 ] && echo "$rows" | grep -q "$hash"; then
      ok "the table holds the session under the hash of its id"
    else
      bad "the table holds the session under the hash of its id" "cookie ${#cookie} chars; rows: $(echo "$rows" | head -3)"
    fi
    if [ -n "$cookie" ] && ! echo "$rows" | grep -q "$cookie"; then
      ok "and the id itself is nowhere in it"
    else
      bad "and the id itself is nowhere in it"
    fi

    # The cookie from before the logout is kept apart. A logout that
    # hands out a new cookie would otherwise pass on the new one, while
    # the old id -- the one somebody may have copied -- still worked.
    cp "$jar" "$jar.before"
    tok=$(token_in "$work/body")
    c=$(status --data-urlencode "_token=$tok" "$b/logout")
    [ "$c" = "303" ] && ok "signed out on node B" || bad "signed out on node B" "got $c"
    c=$(curl -s -o /dev/null -w '%{http_code}' -b "$jar.before" "$a/settings/profile" || true)
    [ "$c" = "303" ] && ok "and node A no longer takes the cookie it had" ||
      bad "and node A no longer takes the cookie it had" "got $c"

    docker rm -f $cname >/dev/null 2>&1
  done

  # The control. Same app, same scenario, memory: node B must be a
  # stranger, or the checks above cannot tell a shared session from any
  # other kind of 200.
  echo
  echo "- the control: memory"
  start_nodes "sqlite:storage/sessions.sqlite" memory && {
    if sign_up_on_a control; then
      c=$(status "$b/settings/profile")
      [ "$c" = "303" ] && ok "with the memory driver node B does not know it" ||
        bad "with the memory driver node B does not know it" "got $c"
      c=$(status "$a/settings/profile")
      [ "$c" = "200" ] && ok "while node A still does" || bad "while node A still does" "got $c"
    else
      bad "signed up on node A with the memory driver" "got $c"
    fi
  }
  docker rm -f $cname >/dev/null 2>&1

  # A driver nobody has written is refused at startup, not taken as memory.
  out=$(in_box "SESSION_DRIVER=redis DATABASE_URL=sqlite:storage/sessions.sqlite timeout 5 ./.build/bin/app $port_a 2>&1; echo exit=\$?" site 2>&1)
  if echo "$out" | grep -q 'Unknown session.driver "redis"' && ! echo "$out" | grep -q 'exit=0'; then
    ok "an unknown driver stops the app at startup, and says so"
  else
    bad "an unknown driver stops the app at startup" "$(echo "$out" | tail -3)"
  fi

  echo
  if [ "$fail" -ne 0 ]; then
    echo "session:check failed."
    return 1
  fi
  echo "session:check holds: a login is the database's, not a process's."
}

# The gate behind docs/auth.md: an app from `askr new --auth`, driven the
# way a browser drives it, over a socket. A new account confirms its
# address with the link in the mail it was sent -- read out of the mail
# log, not made up by the gate -- and nothing but that link opens the
# dashboard. SQLite only: what is checked here is the flow, and the
# drivers have gates of their own.
cmd_auth_check() {
  prepare
  fail=0
  ok()   { echo "  ok    $1"; }
  bad()  { echo "  FAIL  $1"; shift; [ $# -gt 0 ] && printf '        %s\n' "$@"; fail=1; }
  ensure_image

  ac_bin="$BUILD/authcheck-bin"
  ac_units="$BUILD/authcheck-units"
  work="$BUILD/authcheck"
  mkdir -p "$ac_bin" "$ac_units" "$work"
  flags=$(echo "$FPCFLAGS" | sed "s|-FU$UNITS|-FU$ac_units|; s|-FE$BIN|-FE$ac_bin|" |
          sed "s|$ROOT|/work|g" | sed 's/-WM11.0//')
  in_box() {
    docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work \
      -e ASKR_HOME=/work -w "/work/${work#$ROOT/}${2:+/$2}" "$IMAGE" sh -c "$1"
  }
  askr_bin="/work/${ac_bin#$ROOT/}/askr"

  echo "Building the askr tool for the container ..."
  if ! docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
       fpc $flags cli/askr.lpr >"$work/cli.log" 2>&1; then
    bad "the tool builds" "$(grep -iE 'error|fatal' "$work/cli.log" | head -3)"
    return 1
  fi

  out=$(in_box "rm -rf site && $askr_bin new site --auth" 2>&1) || true
  if [ ! -f "$work/site/askr.toml" ]; then
    bad "a project with sign-in is scaffolded" "$(echo "$out" | tail -3)"
    return 1
  fi
  sed -i.bak 's|^version = .*|path = "/work"|; s|^path = .*|path = "/work"|' "$work/site/askr.toml"
  rm -f "$work/site/askr.toml.bak"
  if in_box "$askr_bin build" site >"$work/build.log" 2>&1; then
    ok "a project with sign-in is scaffolded and builds"
  else
    bad "the project builds" "$(grep -E 'rror|Fatal' "$work/build.log" | head -6)"
    return 1
  fi
  for f in layout.html layout.txt auth/verify-email.html auth/verify-email.txt \
           auth/reset-password.html auth/reset-password.txt; do
    [ -f "$work/site/mail/$f" ] || bad "the scaffold writes mail/$f"
  done

  port=${ASKR_AUTH_PORT:-8363}
  base="http://127.0.0.1:$port"
  cname=askr-authcheck
  rm -f "$work/site/storage/auth.sqlite"* "$work/site/storage/mail.log"
  if ! in_box "DATABASE_URL=sqlite:storage/auth.sqlite ./.build/bin/app --migrate" site >"$work/migrate.log" 2>&1; then
    bad "migrate" "$(tail -3 "$work/migrate.log")"
    return 1
  fi
  docker rm -f $cname >/dev/null 2>&1
  docker run -d --name $cname $DOCKER_PLATFORM -p "$port:$port" \
    -e DATABASE_URL=sqlite:storage/auth.sqlite -e APP_URL="$base" \
    -v "$ROOT":/work -w "/work/${work#$ROOT/}/site" "$IMAGE" \
    sh -c "./.build/bin/app $port 0.0.0.0" >/dev/null
  n=0
  until curl -s -o /dev/null "$base/login"; do
    n=$((n + 1))
    if [ $n -gt 80 ]; then
      bad "the app answers" "$(docker logs $cname 2>&1 | tail -4)"
      docker rm -f $cname >/dev/null 2>&1
      return 1
    fi
    sleep 0.25
  done

  jar="$work/jar"
  rm -f "$jar"
  token_in() { grep -o 'name="_token" value="[^"]*"' "$1" | head -1 | sed 's/.*value="//; s/"$//'; }
  # Never a non-zero exit: under set -e a refused connection would end the
  # gate without a word. curl says 000 instead, which fails its check.
  status() { curl -s -o "$work/body" -w '%{http_code}' -b "$jar" -c "$jar" "$@" || true; }
  location() { curl -s -o /dev/null -w '%{redirect_url}' -b "$jar" -c "$jar" "$@" || true; }
  # The newest verification link in the mail log, from the text part: in
  # the html part the & is &amp;, as it should be.
  newest_link() {
    tr -d '\r' < "$work/site/storage/mail.log" 2>/dev/null |
      grep -o "$base/verify-email/[^ \"<]*" | grep -v '&amp;' | tail -1
  }
  mails() { grep -c "^Subject: $1" "$work/site/storage/mail.log" 2>/dev/null || true; }

  email="ada-$(date +%s)@example.com"
  status "$base/register" >/dev/null
  tok=$(token_in "$work/body")
  c=$(status --data-urlencode "_token=$tok" --data-urlencode "name=Ada Lovelace" \
        --data-urlencode "email=$email" \
        --data-urlencode "password=correct-horse-battery" \
        --data-urlencode "password_confirmation=correct-horse-battery" \
        "$base/register")
  [ "$c" = "303" ] && ok "registered, and signed in" || bad "registered" "got $c: $(head -c 300 "$work/body")"

  r=$(location "$base/dashboard")
  case $r in
    */verify-email) ok "the dashboard sends an unconfirmed address to the notice" ;;
    *) bad "the dashboard sends an unconfirmed address to the notice" "went to: $r" ;;
  esac
  c=$(status "$base/verify-email")
  if [ "$c" = "200" ] && grep -q "$email" "$work/body"; then
    ok "which names the address the link went to"
  else
    bad "which names the address the link went to" "got $c"
  fi
  c=$(status "$base/settings/profile")
  [ "$c" = "200" ] && ok "the profile opens without a confirmed address, to fix a mistyped one" ||
    bad "the profile opens without a confirmed address" "got $c"

  link=$(newest_link)
  if [ -n "$link" ] && [ "$(mails 'Confirm your email address')" = "1" ]; then
    ok "one mail went out, with a link in it"
  else
    bad "one mail went out, with a link in it" "$(tail -20 "$work/site/storage/mail.log" 2>/dev/null)"
  fi
  if grep -q "multipart/alternative" "$work/site/storage/mail.log" &&
     grep -q "Confirm my address" "$work/site/storage/mail.log" &&
     tr -d '\r' < "$work/site/storage/mail.log" | grep -q "^site$"; then
    ok "from the templates, in both parts, inside the layout"
  else
    bad "from the templates, in both parts, inside the layout"
  fi

  # The resend button: once, and then not again for a minute.
  status "$base/verify-email" >/dev/null
  tok=$(token_in "$work/body")
  status --data-urlencode "_token=$tok" "$base/verify-email" >/dev/null
  status "$base/verify-email" >/dev/null
  tok=$(token_in "$work/body")
  status --data-urlencode "_token=$tok" "$base/verify-email" >/dev/null
  c=$(status "$base/verify-email")
  if [ "$(mails 'Confirm your email address')" = "2" ] && grep -q "a moment ago" "$work/body"; then
    ok "asking again sends one more, and a third ask within the minute sends none"
  else
    bad "asking again sends one more, and no more" "mails: $(mails 'Confirm your email address')"
  fi
  link=$(newest_link)

  forged=$(echo "$link" | sed 's|/verify-email/\([0-9]*\)/|/verify-email/9\1/|')
  c=$(status "$forged")
  [ "$c" = "403" ] && ok "a link with another id is refused" || bad "a link with another id is refused" "got $c"
  c=$(status "$link&x=1")
  [ "$c" = "403" ] && ok "and one with anything added" || bad "and one with anything added" "got $c"
  c=$(status "$(echo "$link" | sed 's|expires=|expires=9|')")
  [ "$c" = "403" ] && ok "and one with a later expiry" || bad "and one with a later expiry" "got $c"
  r=$(location "$base/dashboard")
  case $r in
    */verify-email) ok "none of them confirmed anything" ;;
    *) bad "none of them confirmed anything" "dashboard went to: $r" ;;
  esac

  # The link itself, from another browser: it proves the mailbox, and
  # signs nobody in.
  c=$(curl -s -o /dev/null -w '%{http_code}' "$link" || true)
  [ "$c" = "303" ] && ok "the link from the mail confirms the address" || bad "the link from the mail confirms" "got $c"
  c=$(status "$base/dashboard")
  if [ "$c" = "200" ] && grep -q "Welcome back, Ada Lovelace" "$work/body"; then
    ok "and the dashboard opens"
  else
    bad "and the dashboard opens" "got $c"
  fi
  c=$(status "$base/verify-email")
  [ "$c" = "303" ] && ok "the notice is out of the way once it is done" || bad "the notice is out of the way once it is done" "got $c"

  # A new address is not confirmed by the old one having been, and the
  # old link does not confirm the new one.
  old_link=$link
  status "$base/settings/profile" >/dev/null
  tok=$(token_in "$work/body")
  status --data-urlencode "_token=$tok" --data-urlencode "name=Ada Lovelace" \
    --data-urlencode "email=new-$email" "$base/settings/profile" >/dev/null
  r=$(location "$base/dashboard")
  case $r in
    */verify-email) ok "a changed address has to be confirmed again" ;;
    *) bad "a changed address has to be confirmed again" "dashboard went to: $r" ;;
  esac
  c=$(status "$old_link")
  if [ "$c" = "403" ] && grep -q "earlier address" "$work/body"; then
    ok "and the link to the old one does not do it"
  else
    bad "and the link to the old one does not do it" "got $c"
  fi
  c=$(curl -s -o /dev/null -w '%{http_code}' "$(newest_link)" || true)
  r=$(location "$base/dashboard")
  [ "$c" = "303" ] && [ -z "$r" ] && ok "the link sent to the new one does" ||
    bad "the link sent to the new one does" "got $c, dashboard went to: $r"

  # The reset mail is a template now too.
  status "$base/forgot-password" >/dev/null
  tok=$(token_in "$work/body")
  status --data-urlencode "_token=$tok" --data-urlencode "email=new-$email" "$base/forgot-password" >/dev/null
  if grep -q "Choose a new password" "$work/site/storage/mail.log" &&
     grep -q "$base/reset-password/" "$work/site/storage/mail.log"; then
    ok "the reset mail comes from its template, with its link"
  else
    bad "the reset mail comes from its template"
  fi

  # ---- two-factor sign-in ----
  echo
  echo "- two-factor sign-in"
  # The code as an authenticator app computes it, in Python's standard
  # library -- not in the Pascal that is being checked. $2 is steps from
  # now.
  totp() {
    python3 -c "import hmac,base64,struct,time,sys
k=base64.b32decode(sys.argv[1]+'='*(-len(sys.argv[1])%8))
c=int(time.time())//30+int(sys.argv[2])
h=hmac.new(k,struct.pack('>Q',c),'sha1').digest();o=h[-1]&15
print(str((struct.unpack('>I',h[o:o+4])[0]&0x7fffffff)%1000000).zfill(6))" "$1" "$2"
  }
  post_form() {  # path, then name=value pairs; the token from the page first
    page=$1; shift
    status "$base$page" >/dev/null
    tok=$(token_in "$work/body")
    set -- --data-urlencode "_token=$tok" "$@"
    status "$@" "$target"
  }
  sign_in() {
    rm -f "$jar"
    status "$base/login" >/dev/null
    tok=$(token_in "$work/body")
    location --data-urlencode "_token=$tok" --data-urlencode "email=new-$email" \
      --data-urlencode "password=$1" "$base/login"
  }

  target="$base/settings/two-factor"
  post_form /settings/security >/dev/null
  c=$(status "$base/settings/two-factor")
  secret=$(grep -o '<code class="secret">[^<]*' "$work/body" | sed 's/.*">//; s/ //g')
  if [ "$c" = "200" ] && grep -q '<svg' "$work/body" && [ ${#secret} -eq 32 ]; then
    ok "set up from the security page: a QR code and the key"
  else
    bad "set up from the security page" "got $c, key '${secret}'"
  fi
  target="$base/settings/two-factor/confirm"
  post_form /settings/two-factor --data-urlencode "code=000000" >/dev/null
  if grep -q "did not match" "$work/body"; then
    ok "a wrong code does not turn it on"
  else
    bad "a wrong code does not turn it on"
  fi
  post_form /settings/two-factor --data-urlencode "code=$(totp "$secret" 0)" >/dev/null
  codes=$(grep -oE '<code>[a-z2-7]{5}-[a-z2-7]{5}</code>' "$work/body" | sed 's/<[^>]*>//g')
  if [ "$(echo "$codes" | grep -c .)" = "8" ]; then
    ok "the code from the app turns it on, and eight recovery codes are shown once"
  else
    bad "the code from the app turns it on" "$(head -c 300 "$work/body")"
  fi
  stored=$(in_box "python3 -c \"import sqlite3; print(sqlite3.connect('storage/auth.sqlite').execute('select two_factor_secret, two_factor_recovery from users').fetchone())\"" site 2>&1 || true)
  first_code=$(echo "$codes" | head -1)
  if echo "$stored" | grep -q "'v1\." && ! echo "$stored" | grep -q "$secret" &&
     ! echo "$stored" | grep -q "$first_code"; then
    ok "the database holds the key sealed and the recovery codes hashed"
  else
    bad "the database holds the key sealed and the recovery codes hashed" "$stored"
  fi

  r=$(sign_in correct-horse-battery)
  case $r in
    */two-factor-challenge) ok "the password alone leads to the code, not in" ;;
    *) bad "the password alone leads to the code" "went to: $r" ;;
  esac
  r=$(location "$base/dashboard")
  case $r in
    */login) ok "and is not signed in until then" ;;
    *) bad "and is not signed in until then" "dashboard went to: $r" ;;
  esac
  target="$base/two-factor-challenge"
  post_form /two-factor-challenge --data-urlencode "code=000000" >/dev/null
  r=$(location "$base/dashboard")
  case $r in
    */login) ok "a wrong code does not let it in" ;;
    *) bad "a wrong code does not let it in" "dashboard went to: $r" ;;
  esac
  # The next step's code: the one that turned it on is spent, and the
  # window takes one step either side.
  next=$(totp "$secret" 1)
  post_form /two-factor-challenge --data-urlencode "code=$next" >/dev/null
  c=$(status "$base/dashboard")
  [ "$c" = "200" ] && ok "the code from the app does" || bad "the code from the app does" "dashboard got $c"

  r=$(sign_in correct-horse-battery)
  post_form /two-factor-challenge --data-urlencode "code=$next" >/dev/null
  c=$(status "$base/dashboard")
  [ "$c" != "200" ] && ok "the same code a second time does not -- it is spent" ||
    bad "the same code a second time does not" "dashboard got $c"

  post_form /two-factor-challenge --data-urlencode "recovery=$(echo "$first_code" | tr 'a-z' 'A-Z' | tr '-' ' ')" >/dev/null
  c=$(status "$base/dashboard")
  [ "$c" = "200" ] && ok "a recovery code does, however it is typed" || bad "a recovery code does" "dashboard got $c"
  r=$(sign_in correct-horse-battery)
  post_form /two-factor-challenge --data-urlencode "recovery=$first_code" >/dev/null
  c=$(status "$base/dashboard")
  [ "$c" != "200" ] && ok "but only once" || bad "a recovery code works only once" "dashboard got $c"

  # A reset link is a way in too, and has to ask for the code as well.
  rm -f "$jar"
  target="$base/forgot-password"
  post_form /forgot-password --data-urlencode "email=new-$email" >/dev/null
  reset=$(tr -d '\r' < "$work/site/storage/mail.log" | grep -o "$base/reset-password/[A-Za-z0-9_-]*" | tail -1)
  target="$base/reset-password"
  status "$reset" >/dev/null
  tok=$(token_in "$work/body")
  rtok=${reset##*/}
  r=$(location --data-urlencode "_token=$tok" --data-urlencode "token=$rtok" \
        --data-urlencode "password=new-horse-battery" \
        --data-urlencode "password_confirmation=new-horse-battery" "$base/reset-password")
  case $r in
    */two-factor-challenge) ok "a password reset asks for the code too, rather than signing in" ;;
    *) bad "a password reset asks for the code too" "went to: $r" ;;
  esac

  # A recovery code from here on: the step after now is spent, and no code
  # is later than it until the clock moves on. That is the property.
  second_code=$(echo "$codes" | sed -n 2p)
  target="$base/two-factor-challenge"
  post_form /two-factor-challenge --data-urlencode "recovery=$second_code" >/dev/null
  c=$(status "$base/dashboard")
  [ "$c" = "200" ] || bad "signed in with the second recovery code" "dashboard got $c"
  target="$base/settings/two-factor/disable"
  post_form /settings/security --data-urlencode "password=wrong-password" >/dev/null
  status "$base/settings/security" >/dev/null
  if grep -q "On since" "$work/body" && grep -q "6 recovery codes left" "$work/body"; then
    ok "turning it off needs the password; and two codes used, six are left"
  else
    bad "turning it off needs the password" "$(grep -o 'On since[^<]*' "$work/body")"
  fi
  target="$base/settings/two-factor/disable"
  post_form /settings/security --data-urlencode "password=new-horse-battery" >/dev/null
  r=$(sign_in new-horse-battery)
  case $r in
    */dashboard) ok "and with it, the password is enough again" ;;
    *) bad "and with it, the password is enough again" "went to: $r" ;;
  esac

  # Six digits are a million guesses and no more, so wrong codes are
  # counted like wrong passwords: after five, even the right one waits.
  target="$base/settings/two-factor"
  post_form /settings/security >/dev/null
  status "$base/settings/two-factor" >/dev/null
  secret2=$(grep -o '<code class="secret">[^<]*' "$work/body" | sed 's/.*">//; s/ //g')
  target="$base/settings/two-factor/confirm"
  post_form /settings/two-factor --data-urlencode "code=$(totp "$secret2" 0)" >/dev/null
  sign_in new-horse-battery >/dev/null
  target="$base/two-factor-challenge"
  for i in 1 2 3 4 5; do
    post_form /two-factor-challenge --data-urlencode "code=00000$i" >/dev/null
  done
  post_form /two-factor-challenge --data-urlencode "code=$(totp "$secret2" 1)" >/dev/null
  # The page first: a flash lasts one request, and the dashboard would
  # take it.
  status "$base/two-factor-challenge" >/dev/null
  cp "$work/body" "$work/challenge-body"
  c=$(status "$base/dashboard")
  if [ "$c" != "200" ] && grep -q "Too many attempts" "$work/challenge-body"; then
    ok "after five wrong codes, the right one waits too"
  else
    bad "after five wrong codes, the right one waits too" "dashboard got $c"
  fi

  docker rm -f $cname >/dev/null 2>&1

  echo
  if [ "$fail" -ne 0 ]; then
    echo "auth:check failed."
    return 1
  fi
  echo "auth:check holds: an address is confirmed by the mail it was sent, and a password is not a way in on its own once two-factor is on."
}

# The gate behind Askr.Qr: codes at every level, from a few bytes to what
# version 40 holds, read back by Chrome's own barcode reader and compared
# with the text they were made from. The suite holds the encoder to
# another encoder, module for module; this holds it to a reader, which is
# what a phone is. The reader is there in Chrome on macOS; elsewhere the
# gate says so and does not claim to have run.
cmd_qr_check() {
  prepare
  ensure_image
  chrome=${ASKR_CHROME:-"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"}
  [ -x "$chrome" ] || chrome=$(command -v google-chrome || command -v chromium || true)
  if ! command -v node >/dev/null 2>&1 || [ -z "$chrome" ] || [ ! -x "$chrome" ]; then
    echo "qr:check needs node and Chrome (ASKR_CHROME). Skipped, not passed."
    return 0
  fi
  work="$BUILD/qrcheck"
  qr_units="$BUILD/qrcheck-units"
  rm -rf "$work"
  mkdir -p "$work" "$qr_units"
  flags=$(echo "$FPCFLAGS" | sed "s|-FU$UNITS|-FU$qr_units|; s|-FE$BIN|-FE$work|" |
          sed "s|$ROOT|/work|g" | sed 's/-WM11.0//')
  if ! docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
       sh -c "fpc $flags tools/qr/qrwrite.lpr && /work/${work#$ROOT/}/qrwrite /work/${work#$ROOT/}/codes" \
       >"$work/build.log" 2>&1; then
    echo "  FAIL  the codes are written"
    grep -iE 'error|fatal' "$work/build.log" | head -5
    return 1
  fi
  echo '<!doctype html><title>qr:check</title>' > "$work/codes/index.html"
  web=${ASKR_QR_WEB:-9235}
  ( cd "$work/codes" && exec python3 -m http.server "$web" --bind 127.0.0.1 ) >/dev/null 2>&1 &
  web_pid=$!
  profile=$(mktemp -d)
  port=${ASKR_QR_CDP:-9232}
  "$chrome" --headless --disable-gpu --remote-debugging-port=$port \
    --user-data-dir="$profile" about:blank >/dev/null 2>&1 &
  chrome_pid=$!
  n=0
  until curl -s -o /dev/null "http://127.0.0.1:$port/json/list" &&
        curl -s -o /dev/null "http://127.0.0.1:$web/"; do
    n=$((n + 1))
    if [ $n -gt 80 ]; then
      echo "  FAIL  Chrome and the page start"
      kill "$chrome_pid" "$web_pid" 2>/dev/null
      return 1
    fi
    sleep 0.25
  done
  code=0
  DIR="$work/codes" CDP="http://127.0.0.1:$port" PAGE="http://127.0.0.1:$web/" \
    node "$ROOT/tools/qr/qrread.mjs" || code=$?
  # || true: wait gives the status of what was just killed, 143, and
  # under set -e that ended the gate after every code had passed.
  kill "$chrome_pid" "$web_pid" 2>/dev/null || true
  wait "$chrome_pid" "$web_pid" 2>/dev/null || true
  rm -rf "$profile"
  echo
  case $code in
    0) echo "qr:check holds: every code reads back as the text it was made from." ;;
    2) echo "qr:check skipped: no QR reader in this Chrome. Not passed." ;;
    *) echo "qr:check failed."; return 1 ;;
  esac
}

# The gate behind Askr.Http.WebSocket: the Autobahn test suite -- the
# conformance suite for websocket servers -- against an echo server built
# on Askr. Every case but compression and the performance runs (9, 12 and
# 13), which Askr does not do. A case is held when Autobahn says OK,
# NON-STRICT or INFORMATIONAL; anything else fails the gate, by name.
cmd_ws_check() {
  prepare
  ensure_image
  if ! docker image inspect crossbario/autobahn-testsuite >/dev/null 2>&1; then
    echo "ws:check needs the Autobahn image: docker pull crossbario/autobahn-testsuite. Skipped, not passed."
    return 0
  fi
  work="$BUILD/wscheck"
  mkdir -p "$work"
  rm -rf "$work/reports"
  flags=$(echo "$FPCFLAGS" | sed "s|-FU$UNITS|-FU$work|; s|-FE$BIN|-FE$work|" |
          sed "s|$ROOT|/work|g" | sed 's/-WM11.0//')
  if ! docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
       fpc $flags tools/ws/wsecho.lpr >"$work/build.log" 2>&1; then
    echo "  FAIL  the echo server builds"
    grep -iE 'error|fatal' "$work/build.log" | head -5
    return 1
  fi
  net=askr-wscheck
  docker network create $net >/dev/null 2>&1 || true
  docker rm -f askr-wsecho >/dev/null 2>&1
  docker run -d --name askr-wsecho --network $net $DOCKER_PLATFORM \
    -v "$ROOT":/work -w /work "$IMAGE" "/work/${work#$ROOT/}/wsecho" 9001 >/dev/null
  cat > "$work/fuzzingclient.json" <<'JSON'
{
  "outdir": "/work/reports",
  "servers": [{ "agent": "askr", "url": "ws://askr-wsecho:9001" }],
  "cases": ["*"],
  "exclude-cases": ["9.*", "12.*", "13.*"],
  "exclude-agent-cases": {}
}
JSON
  sleep 1
  code=0
  docker run --rm --network $net -v "$work":/work crossbario/autobahn-testsuite \
    wstest -m fuzzingclient -s /work/fuzzingclient.json >"$work/wstest.log" 2>&1 || code=$?
  docker rm -f askr-wsecho >/dev/null 2>&1
  docker network rm $net >/dev/null 2>&1 || true
  if [ ! -f "$work/reports/index.json" ]; then
    echo "  FAIL  Autobahn ran and wrote its report (exit $code)"
    tail -8 "$work/wstest.log"
    return 1
  fi
  python3 - "$work/reports/index.json" <<'PY'
import json, sys
r = json.load(open(sys.argv[1]))['askr']
good = ('OK', 'NON-STRICT', 'INFORMATIONAL')
bad = sorted(((k, v['behavior'], v['behaviorClose']) for k, v in r.items()
              if v['behavior'] not in good or v['behaviorClose'] not in good + ('UNCLEAN',)),
             key=lambda t: [int(x) for x in t[0].split('.')])
counts = {}
for v in r.values():
    counts[v['behavior']] = counts.get(v['behavior'], 0) + 1
print('  cases: %d  %s' % (len(r), '  '.join('%s %d' % kv for kv in sorted(counts.items()))))
for k, b, c in bad:
    print('  FAIL  %s: %s, close %s' % (k, b, c))
sys.exit(1 if bad else 0)
PY
  if [ $? -ne 0 ]; then
    echo
    echo "ws:check failed. The report is in $work/reports/index.html."
    return 1
  fi
  echo
  echo "ws:check holds: every Autobahn case it runs is OK, NON-STRICT or INFORMATIONAL."
}

# The gate behind Askr.Storage's S3 disk: put, read, look for, presign and
# delete against a real S3 server that checks every signature -- the Versity
# gateway, with a posix backend on a volume of its own. Not AWS: nothing has
# been sent to AWS from here, and docs/storage.md says so.
cmd_storage_check() {
  prepare
  ensure_image
  if ! docker image inspect versity/versitygw >/dev/null 2>&1; then
    echo "storage:check needs the S3 gateway: docker pull versity/versitygw. Skipped, not passed."
    return 0
  fi
  work="$BUILD/storagecheck"
  mkdir -p "$work"
  flags=$(echo "$FPCFLAGS" | sed "s|-FU$UNITS|-FU$work|; s|-FE$BIN|-FE$work|" |
          sed "s|$ROOT|/work|g" | sed 's/-WM11.0//')
  if ! docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
       fpc $flags tools/storage/s3probe.lpr >"$work/build.log" 2>&1; then
    echo "  FAIL  the probe builds"
    grep -iE 'error|fatal' "$work/build.log" | head -5
    return 1
  fi
  net=askr-storagecheck
  vol=askr-storagecheck-data
  docker rm -f askr-vgw >/dev/null 2>&1
  docker volume rm $vol >/dev/null 2>&1 || true
  docker network create $net >/dev/null 2>&1 || true
  docker volume create $vol >/dev/null
  docker run -d --name askr-vgw --network $net -v $vol:/data versity/versitygw \
    --access askr-check-key --secret askr-check-secret-0123456789 --port :7070 \
    posix /data >/dev/null
  sleep 1
  code=0
  docker run --rm --network $net $DOCKER_PLATFORM -v "$ROOT":/work -w /work "$IMAGE" \
    "/work/${work#$ROOT/}/s3probe" http://askr-vgw:7070 askr-check-key \
    askr-check-secret-0123456789 || code=$?
  if [ $code -ne 0 ]; then
    docker logs askr-vgw 2>&1 | tail -5
  fi
  docker rm -f askr-vgw >/dev/null 2>&1
  docker volume rm $vol >/dev/null 2>&1 || true
  docker network rm $net >/dev/null 2>&1 || true
  echo
  if [ $code -ne 0 ]; then
    echo "storage:check failed."
    return 1
  fi
  echo "storage:check holds: an S3 server that checks every signature takes every one of these."
}

cmd_seo_check() {
  prepare

  if ! command -v node >/dev/null 2>&1; then
    echo "seo:check hoppet over: node finnes ikke."
    return 0
  fi
  chrome=${ASKR_CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}
  if [ ! -x "$chrome" ]; then
    chrome=$(command -v google-chrome || command -v chromium || true)
  fi
  if [ -z "$chrome" ] || [ ! -x "$chrome" ]; then
    echo "seo:check hoppet over: fant ingen Chrome."
    echo "  Sett ASKR_CHROME til en kjørbar Chrome for å kjøre den."
    return 0
  fi

  if [ ! -f "$ROOT/examples/inertia/public/build/.vite/manifest.json" ]; then
    echo "Bygger demoens frontend ..."
    ( cd "$ROOT/examples/inertia/frontend" &&
      npm install --silent --no-fund --no-audit && npm run build ) >/dev/null
  fi

  fpc_run examples/inertia/inertiademo.lpr

  port=8133
  cdpport=9224
  # Natively when there is a local fpc, otherwise in the container with the
  # port mapped out -- fpc_run builds for whichever one it used, and a Linux
  # binary does not run on the host that Chrome is on.
  if have_local_fpc; then
    ASKR_WEB_ROOT="$ROOT/examples/inertia" "$BIN/inertiademo" "$port" \
      >/tmp/askr-seo-demo.log 2>&1 &
  else
    ensure_image
    docker run --rm -p "$port:$port" $DOCKER_PLATFORM -v "$ROOT":/work \
      -w /work -e ASKR_WEB_ROOT=/work/examples/inertia "$IMAGE" \
      "/work/${BIN#$ROOT/}/inertiademo" "$port" 0.0.0.0 \
      >/tmp/askr-seo-demo.log 2>&1 &
  fi
  demopid=$!
  "$chrome" --headless=new --remote-debugging-port=$cdpport \
    --user-data-dir=/tmp/askr-seo-cdp --no-first-run --disable-gpu \
    about:blank >/tmp/askr-seo-chrome.log 2>&1 &
  chromepid=$!
  # Both are killed whatever happens below, including a failure.
  trap 'kill $demopid $chromepid 2>/dev/null' EXIT INT TERM
  sleep 6

  echo "askr - seo"
  echo
  echo "- what a reader without JavaScript gets"
  body=$(curl -s --max-time 10 "http://127.0.0.1:$port/" || true)
  visible=$(printf '%s' "$body" | python3 -c "
import sys, re
h = sys.stdin.read()
m = re.search(r'<body[^>]*>(.*)</body>', h, re.S)
b = m.group(1) if m else ''
t = re.sub(r'<script.*?</script>', '', b, flags=re.S)
t = re.sub(r'<[^>]+>', ' ', t)
print(len(' '.join(t.split())))
" 2>/dev/null || echo 0)
  if [ "${visible:-0}" -gt 20 ]; then
    echo "  ok    the body has $visible characters to read"
  else
    echo "  FAIL  the body has $visible characters to read"
    fail=1
  fi

  echo
  echo "- and whether the client replaces it"
  if ASKR_CDP="http://127.0.0.1:$cdpport" \
     ASKR_URL="http://127.0.0.1:$port/" \
     node "$ROOT/tests/browser/hydration.mjs"; then
    :
  else
    fail=1
  fi

  kill $demopid $chromepid 2>/dev/null
  trap - EXIT INT TERM

  echo
  if [ "${fail:-0}" -ne 0 ]; then
    echo "seo:check feilet."
    return 1
  fi
  echo "seo:check holder: en leser uten JavaScript får noe å lese."
}

cmd_mcp_check() {
  prepare
  fpc_run cli/askr.lpr

  # The version this checkout is, read the same way TreeVersion reads it.
  askrver=$(sed -n "s/.*AskrVersion *= *'\\([^']*\\)'.*/\\1/p" \
    "$ROOT/src/core/Askr.Core.Version.pas" | head -1)

  dir="$BUILD/mcpcheck"
  rm -rf "$dir"
  mkdir -p "$dir"

  # Two projects: one that deliberately does not compile, and one that does.
  # Both directions have to hold -- a build tool that always says FAILED is
  # as useless as one that always says OK.
  mkdir -p "$dir/ok"
  # The framework path has to be the one the building process actually sees.
  # Natively that is $ROOT; in the container the repo is mounted at /work,
  # and a host path there gives "not an Askr checkout" instead of a compile.
  if have_local_fpc; then fwpath="$ROOT"; else fwpath=/work; fi
  write_toml() {  # $1 = directory, $2 = name
    cat > "$1/askr.toml" <<TOML
name = "$2"
main = "app.lpr"
units = "app"

[askr]
path = "$fwpath"
TOML
  }
  write_toml "$dir" mcpcheck
  write_toml "$dir/ok" mcpok

  # A type error, not a syntax error: that is the shape Askr actually
  # promises to catch -- the wrong type against a typed column is the same
  # mechanism.
  cat > "$dir/app.lpr" <<'LPR'
program app;
var
  I: Integer;
begin
  I := 'not an integer';
  WriteLn(I);
end.
LPR
  cat > "$dir/ok/app.lpr" <<'LPR'
program app;
begin
  WriteLn('ok');
end.
LPR

  frames='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"check","version":"1"}}}
{"jsonrpc":"2.0","method":"notifications/initialized"}
{"jsonrpc":"2.0","id":2,"method":"tools/list"}
{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"build","arguments":{}}}
{"jsonrpc":"2.0","id":4,"method":"ping"}'

  # The docs tools are driven separately: the build frames above take a
  # compile each, and these need none.
  docframes='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"docs_search","arguments":{"query":"BackWithErrors"}}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"docs_search","arguments":{"query":"Back.WithErrors"}}}
{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"docs_read","arguments":{"page":"validation","section":"Across a redirect"}}}
{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"docs_read","arguments":{}}}
{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"docs_read","arguments":{"page":"../README.md"}}}
{"jsonrpc":"2.0","id":6,"method":"ping"}'

  # A ceiling on the call itself. The whole point of the test tool is that
  # a hung suite cannot hang the agent, and a gate that proves it by
  # hanging is worse than none -- it stalls ./askr test with no message.
  # Generous: the longest honest call here is a scaffolded app compiling,
  # which is seconds. This is the last resort, not the deadline being
  # tested -- and it has to fail in a bounded time, or it is the same
  # problem one level up.
  if command -v timeout >/dev/null 2>&1; then
    cap="timeout 120"
  else
    cap=""
  fi

  run_mcp_in() {  # $1 = directory relative to ROOT, $2 = frames (default $frames)
    f=${2:-$frames}
    if have_local_fpc; then
      ( cd "$ROOT/$1" && printf '%s\n' "$f" | $cap "$BIN/askr" mcp )
    else
      ensure_image
      printf '%s\n' "$f" | $cap docker run --rm -i $DOCKER_PLATFORM \
        -v "$ROOT":/work -w "/work/$1" "$IMAGE" "/work/${BIN#$ROOT/}/askr" mcp
    fi
  }

  fail=0
  check() {  # $1 = description, $2 = output, $3 = pattern
    if printf '%s' "$2" | grep -q "$3"; then
      echo "  ok    $1"
    else
      echo "  FAIL  $1"
      echo "        did not find: $3"
      fail=1
    fi
  }

  # One reply, by its id. Grepping the whole stream is right for the
  # properties that are about the stream -- that every line is JSON, that a
  # password is nowhere in it -- and wrong for everything else: "the tables
  # are listed" passed against an error message that happened to contain
  # the table name, and "with no error" matched a different reply entirely.
  # Both were green and both were meaningless.
  reply_of() {  # $1 = id, $2 = output
    printf '%s\n' "$2" | grep "\"id\":$1," || true
  }

  check_id() {  # $1 = id, $2 = description, $3 = output, $4 = pattern
    check "$2" "$(reply_of "$1" "$3")" "$4"
  }

  pure_json() {  # $1 = output
    if printf '%s\n' "$1" | grep -vq '^{.*}$'; then
      echo "  FAIL  stdout is nothing but JSON"
      printf '%s\n' "$1" | grep -vn '^{.*}$' | sed 's/^/        /'
      fail=1
    else
      echo "  ok    stdout is nothing but JSON"
    fi
  }

  echo "askr - mcp"
  echo
  echo "- in a project that does not compile"
  # `|| true` because set -e would otherwise kill the script in silence when
  # the server exits non-zero -- and then the gate reports nothing about what
  # was wrong. A gate that fails without saying why is worse than none.
  out=$(run_mcp_in "${BUILD#$ROOT/}/mcpcheck" 2>/dev/null || true)
  check "the handshake answers"            "$out" '"serverInfo"'
  check "with the client's protocol version" "$out" '"protocolVersion":"2025-06-18"'
  check "the tool list answers"            "$out" '"name":"build"'
  # The schema has to come out as JSON, not as a string with quotes in it.
  # That is the whole reason ToolsListReply uses W.Raw.
  check "with the schema as an object"     "$out" '"inputSchema":{"type":"object"'
  # Four replies, not five: the notification gets none. Answer it and the
  # client matches it against a request it never sent.
  check "the notification got no reply" \
    "$(printf '%s\n' "$out" | grep -c '^{')" '^4$'
  check "build reports that it failed"     "$out" 'FAILED'
  # What the tool is for: a position to go to, not a wall of text.
  check "with file, line and column"       "$out" 'app.lpr:5:8'
  check "and the severity"                 "$out" 'Error: '
  # A failed build is a successful tool call reporting bad news. Conflate the
  # two and the agent tries to fix the wrong thing.
  check "but the call itself went fine"    "$out" '"isError":false'
  # Every line on stdout is one JSON object. A single human line here makes
  # the whole stream invalid for the client.
  pure_json "$out"

  # The build just failed, so there is no binary. routes and schema read
  # the compiled binary, and an agent will ask for them in exactly this
  # state -- they have to say so rather than answer emptily.
  out2=$(run_mcp_in "${BUILD#$ROOT/}/mcpcheck" \
    '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"routes","arguments":{}}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"schema","arguments":{}}}' \
    2>/dev/null || true)
  check_id 1 "routes says the app is not built"  "$out2" 'not built'
  check_id 1 "and that is a real tool error"     "$out2" '"isError":true'
  check_id 2 "schema says the same"              "$out2" 'not built'
  pure_json "$out2"

  echo
  echo "- in a project that compiles"
  out=$(run_mcp_in "${BUILD#$ROOT/}/mcpcheck/ok" 2>/dev/null || true)
  check "build reports that it worked"     "$out" 'OK  built'
  check "and no errors"                    "$out" '"isError":false'

  echo
  echo "- with a framework path that is not a checkout"
  # This is the case that found both the stdout leak and the Halt: BuildFlags
  # wrote the message to stdout and killed the process halfway through a
  # reply. The client saw the pipe close with nothing to report.
  bad="$BUILD/mcpbadpath"
  mkdir -p "$bad"
  write_toml "$bad" mcpbadpath
  # Pointing at itself: a directory that exists but is not Askr.
  if have_local_fpc; then selfpath="$bad"; else selfpath="/work/${bad#$ROOT/}"; fi
  sed -i.bak "s|^path = .*|path = \"$selfpath\"|" "$bad/askr.toml"
  rm -f "$bad/askr.toml.bak"
  cp "$dir/ok/app.lpr" "$bad/app.lpr"
  out=$(run_mcp_in "${BUILD#$ROOT/}/mcpbadpath" 2>/dev/null || true)
  check "the tool says what is wrong"      "$out" 'not an Askr checkout'
  check "and that it was the tool that could not run" "$out" '"isError":true'
  # The decisive one: the server is still standing. Halt(1) here answered the
  # handshake and vanished, and the two above would still have been green.
  check "and the server is still standing" "$out" '"id":4'
  pure_json "$out"

  echo
  echo "- the docs tools"
  out=$(run_mcp_in "${BUILD#$ROOT/}/mcpcheck/ok" "$docframes" 2>/dev/null || true)
  check "a real name is found"             "$out" 'validation.md:'
  check "with the version the docs are for" "$out" "for Askr $askrver"
  # The one that matters. Back.WithErrors is the wrong name for
  # BackWithErrors, and it is a mistake that was made in this repository.
  # A search that ignored punctuation would match it against the real name
  # and hand back a page that reads as confirmation.
  # The reply is JSON, so the quotes around the query arrive escaped.
  check "a name that does not exist is not found" "$out" 'No match for .*Back[.]WithErrors'
  check "a section reads"                  "$out" 'Across a redirect'
  check "no page lists the pages"          "$out" 'uploads.md'
  # A page name is text an agent wrote.
  check "a path cannot escape docs/"       "$out" 'No page named'
  check "and that is a real tool error"    "$out" '"isError":true'
  check "the server is still standing"     "$out" '"id":6'
  pure_json "$out"

  echo
  echo "- the docs follow the projects pin, not the tool"
  # The architectural claim of these two tools: `askr mcp` runs before
  # FindProject and never delegates, so the binary answering may be a
  # different release from the one the project builds with. An agent reading
  # this tools docs for a project pinned elsewhere would be confidently
  # wrong, and nothing would say so.
  #
  # A fabricated tree with its own version and its own single page is the
  # only way to tell the two apart in one repository.
  # A new directory every run, not one deleted and made again: Docker
  # Desktop's mount cache let the container read the old tree after the
  # host had replaced it, and the scenario failed one run in a few with
  # nothing wrong. The same trap as askr new refusing a directory the
  # host had removed.
  rm -rf "$BUILD"/mcpfakefw-* "$BUILD"/mcpfakeproj-*
  fake="$BUILD/mcpfakefw-$$"
  mkdir -p "$fake/src/core" "$fake/cli" "$fake/docs"
  cat > "$fake/src/core/Askr.Core.Version.pas" <<'PAS'
unit Askr.Core.Version;
interface
const
  AskrVersion = '0.0.1-fake';
implementation
end.
PAS
  cat > "$fake/docs/onlyfake.md" <<'MD'
# Fake

## Only here

sentinel-only-in-the-fake-tree
MD
  fakeproj="$BUILD/mcpfakeproj-$$"
  mkdir -p "$fakeproj"
  if have_local_fpc; then fakepath="$fake"; else fakepath="/work/${fake#$ROOT/}"; fi
  cat > "$fakeproj/askr.toml" <<TOML
name = "mcpfakeproj"
main = "app.lpr"
units = "app"

[askr]
path = "$fakepath"
TOML
  fakeframes='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"docs_search","arguments":{"query":"sentinel-only-in-the-fake-tree"}}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"docs_search","arguments":{"query":"BackWithErrors"}}}'
  out=$(run_mcp_in "${fakeproj#$ROOT/}" "$fakeframes" 2>/dev/null || true)
  check "the pinned trees own page is found" "$out" 'onlyfake.md:'
  check "and its version is reported"      "$out" 'for Askr 0.0.1-fake'
  # The decisive one: this repositorys docs are NOT what answered.
  check "the tools own docs are not read" "$out" 'No match for .*BackWithErrors'
  pure_json "$out"

  echo
  echo "- a real app, with a secret in .env"
  # The gate this scenario exists for: no tool output ever contains a
  # password. Every tool is driven, so a tool added later that leaks is
  # caught by an assertion nobody had to remember to write.
  #
  # The three keys are not interchangeable. DATABASE_URL and MAIL_PASSWORD
  # are on LooksSecret's list; STRIPE_LIVE_ACCOUNT is not, and `askr config
  # --values` prints it in full. That is measured, not assumed, and it is
  # the whole reason the config tool shows no values at all rather than
  # redacting: a redactor is a list of words, and the word that matters is
  # the one not on it yet.
  SENTINEL=hunter2-SECRET-PW
  app="$BUILD/mcpapp"
  mkdir -p "$app"
  # The removal happens in the same container as the scaffold, not on the
  # host first. Docker Desktop's mount cache does not always invalidate a
  # host-side delete before the next container looks -- the container then
  # still sees shop/, and `askr new` refuses because the directory is
  # there. Same fault as the one capture.sh works around from the other
  # side, where a host-side write read as empty inside the container.
  #
  # Not silenced into `set -e` either. Everything below depends on the
  # scaffold having worked, and a gate that dies at the header line with
  # no message is the failure mode this whole file exists to avoid.
  if have_local_fpc; then
    scaffold=$( ( rm -rf "$app/shop" && cd "$app" &&
      "$BIN/askr" new shop --no-auth ) 2>&1 ) || true
  else
    ensure_image
    scaffold=$(docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work \
      -w "/work/${app#$ROOT/}" "$IMAGE" sh -c \
      "rm -rf shop && /work/${BIN#$ROOT/}/askr new shop --no-auth" 2>&1) || true
  fi
  if [ ! -f "$app/shop/askr.toml" ]; then
    echo "  FAIL  askr new scaffolded a project"
    printf '%s\n' "$scaffold" | sed 's/^/        /'
    fail=1
    return 1
  fi
  if have_local_fpc; then fwp="$ROOT"; else fwp=/work; fi
  sed -i.bak "s|^path = .*|path = \"$fwp\"|" "$app/shop/askr.toml"
  rm -f "$app/shop/askr.toml.bak"
  cat > "$app/shop/.env" <<ENV
APP_ENV=local
DATABASE_URL=postgres://shopuser:$SENTINEL@db.invalid:5432/shop
MAIL_PASSWORD=$SENTINEL
STRIPE_LIVE_ACCOUNT=acct_$SENTINEL
ENV

  appframes='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"build","arguments":{}}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"routes","arguments":{}}}
{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"config","arguments":{}}}
{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"schema","arguments":{}}}
{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"schema","arguments":{"table":"askr_migrations"}}}
{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"docs_search","arguments":{"query":"DATABASE_URL"}}}
{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"docs_read","arguments":{"page":"configuration"}}}
{"jsonrpc":"2.0","id":8,"method":"ping"}'
  out=$(run_mcp_in "${app#$ROOT/}/shop" "$appframes" 2>/dev/null || true)

  check_id 1 "the app builds"                 "$out" 'OK  built'
  check_id 2 "routes answers from the binary" "$out" 'GET'
  check_id 3 "config names a key"             "$out" 'STRIPE_LIVE_ACCOUNT'
  check_id 3 "and the layer it came from"     "$out" '[.]env'
  check_id 3 "but never a value"              "$out" 'Values are not shown'
  # The database is not reachable, which is the interesting half: a
  # connection error is where a DSN leaks if it is going to.
  check_id 4 "schema says it could not connect" "$out" 'Could not connect'
  check_id 4 "naming the driver, not the DSN" "$out" 'postgres database'
  check_id 4 "and that is a real tool error"  "$out" '"isError":true'
  check "the server is still standing"        "$out" '"id":8'
  pure_json "$out"

  # A DSN with no scheme at all reaches a different raise -- one that used
  # to print the whole DSN back. It happens: the password pasted into
  # DATABASE_URL on its own is exactly this shape, and a DSN that is wrong
  # in some other way still carries a password that is right.
  printf 'APP_ENV=local\nDATABASE_URL=%s\n' \
    "$SENTINEL" > "$app/shop/.env"
  out2=$(run_mcp_in "${app#$ROOT/}/shop" \
    '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"schema","arguments":{}}}' \
    2>/dev/null || true)
  check_id 1 "a DSN with no scheme says what was expected" "$out2" \
    'must start with one of'
  out="$out
$out2"

  # THE gate. Inverted: finding it is the failure.
  if printf '%s\n' "$out" | grep -q "$SENTINEL"; then
    echo "  FAIL  no tool output contains the password"
    printf '%s\n' "$out" | grep -n "$SENTINEL" | cut -c1-160 | sed 's/^/        /'
    fail=1
  else
    echo "  ok    no tool output contains the password"
  fi

  echo
  echo "- and the schema tool reports a database it can reach"
  # Both directions, as for build: a tool that always errors is as useless
  # as one that always says OK.
  printf 'APP_ENV=local\nDATABASE_URL=sqlite:storage/app.db\n' > "$app/shop/.env"
  # Migrated first, so there is a real table to report. Without this the
  # tool answers `No table named "askr_migrations"` -- which contains the
  # table name, and is what the first version of this check passed on.
  if have_local_fpc; then
    ( cd "$app/shop" && "$BIN/askr" migrate >/dev/null 2>&1 )
  else
    docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work \
      -w "/work/${app#$ROOT/}/shop" "$IMAGE" \
      "/work/${BIN#$ROOT/}/askr" migrate >/dev/null 2>&1
  fi
  out=$(run_mcp_in "${app#$ROOT/}/shop" \
    '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"schema","arguments":{}}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"schema","arguments":{"table":"askr_migrations"}}}' \
    2>/dev/null || true)
  check_id 1 "the driver is reported"          "$out" 'Driver     sqlite'
  check_id 1 "the tables are listed"           "$out" '1 table(s)'
  check_id 2 "and one table gives its columns" "$out" 'version'
  check_id 2 "with no error"                   "$out" '"isError":false'
  pure_json "$out"

  echo
  echo "- the test tool"
  # Four outcomes, and the exit code can only tell two of them apart. A
  # suite that did not compile and a suite that failed both exit non-zero,
  # and they need opposite work.
  mkdir -p "$app/shop/tests"
  write_suite() {  # $1 = the body of the one test
    cat > "$app/shop/tests/app_tests.lpr" <<LPR
program app_tests;
{\$mode Delphi}{\$H+}
uses
{\$IFDEF UNIX}
  cthreads,
{\$ENDIF}
  SysUtils, Askr.Testing;

procedure TestArithmetic;
begin
  $1
end;

begin
  Group('Arithmetic');
  Test('adds up', @TestArithmetic);
  RunTestsAndHalt;
end.
LPR
  }
  testframes='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"test","arguments":{}}}
{"jsonrpc":"2.0","id":2,"method":"ping"}'

  write_suite "AssertEqual(2 + 2, 4, 'two and two');"
  out=$(run_mcp_in "${app#$ROOT/}/shop" "$testframes" 2>/dev/null || true)
  check_id 1 "a passing suite is reported as passing" "$out" 'OK  the suite passed'
  check_id 1 "with what the suite printed"            "$out" '0 failures'
  check_id 1 "and it is not a tool error"             "$out" '"isError":false'

  write_suite "AssertEqual(2 + 2, 5, 'two and two');"
  out=$(run_mcp_in "${app#$ROOT/}/shop" "$testframes" 2>/dev/null || true)
  check_id 1 "a failing suite says the suite failed"  "$out" 'FAILED  the suite ran'
  # A failing test is a successful call reporting bad news, as a failing
  # build is. Conflate them and an agent hunts for a broken tool.
  check_id 1 "but the call itself went fine"          "$out" '"isError":false'

  write_suite "AssertEqual(NoSuchThing, 5, 'two and two');"
  out=$(run_mcp_in "${app#$ROOT/}/shop" "$testframes" 2>/dev/null || true)
  check_id 1 "a suite that will not compile says so"  "$out" 'did not compile'
  # The same shape the build tool gives. An agent should not meet compiler
  # errors in two forms depending on which call found them.
  check_id 1 "with file, line and column"             "$out" 'app_tests.lpr:11:'
  # One mistake, not the four error-level lines fpc prints around it.
  check_id 1 "and one error, not four"                "$out" '(1 error,'

  # A hang. A person at a terminal presses Ctrl-C; an agent cannot, and a
  # tool that never returns takes the session with it.
  write_suite "WriteLn('before the hang'); Flush(Output); while True do Sleep(1000);"
  out=$(run_mcp_in "${app#$ROOT/}/shop" \
    '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"test","arguments":{"timeout_seconds":3}}}
{"jsonrpc":"2.0","id":2,"method":"ping"}' 2>/dev/null || true)
  check_id 1 "a hanging suite is stopped"        "$out" 'TIMED OUT  after 3 seconds'
  check_id 1 "and what it had printed is kept"   "$out" 'before the hang'
  check "and the server is still standing"       "$out" '"id":2'
  pure_json "$out"

  # A project that never had tests, rather than deleting the one above:
  # the hang scenario's container is still shutting down at this point,
  # and an rm -rf racing it left the file in place on the slower of the
  # two architectures. The assertion then passed or failed by timing.
  out=$(run_mcp_in "${BUILD#$ROOT/}/mcpcheck/ok" "$testframes" 2>/dev/null || true)
  check_id 1 "no test file is a tool error"      "$out" '"isError":true'
  check_id 1 "and it says where it looked"       "$out" 'tests/app_tests.lpr'

  echo
  echo "- what askr new leaves for an agent"
  # The scaffolded project from the scenario above already has AGENTS.md.
  ag="$app/shop/AGENTS.md"
  if [ -f "$ag" ]; then
    echo "  ok    askr new writes AGENTS.md"
  else
    echo "  FAIL  askr new writes AGENTS.md"
    fail=1
  fi

  # The drift that actually happens: a tool is added, renamed or removed
  # and the file that tells an agent what to reach for is not touched.
  # Both directions, because either one alone leaves half of it rotting.
  registered=$(run_mcp_in "${app#$ROOT/}/shop" \
      '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' 2>/dev/null \
    | tr ',' '\n' | sed -n 's/.*"name":"\([a-z_]*\)".*/\1/p' | sort -u)
  listed=$(sed -n 's/^| `\([a-z_]*\)` |.*/\1/p' "$ag" | sort -u)

  # A loop, not comm with process substitution: this script runs under sh.
  missing=""
  for t in $registered; do
    printf '%s\n' "$listed" | grep -qx "$t" || missing="$missing $t"
  done
  extra=""
  for t in $listed; do
    printf '%s\n' "$registered" | grep -qx "$t" || extra="$extra $t"
  done
  if [ -z "$missing" ] && [ -n "$registered" ]; then
    echo "  ok    every registered tool is named in AGENTS.md"
  else
    echo "  FAIL  every registered tool is named in AGENTS.md"
    echo "        not named: $missing"
    fail=1
  fi
  if [ -z "$extra" ]; then
    echo "  ok    and AGENTS.md names no tool that does not exist"
  else
    echo "  FAIL  and AGENTS.md names no tool that does not exist"
    echo "        no such tool: $extra"
    fail=1
  fi

  echo
  echo "- askr mcp:install"
  ins() {  # $@ = arguments
    if have_local_fpc; then
      ( cd "$app/shop" && "$BIN/askr" mcp:install "$@" 2>&1 )
    else
      docker run --rm $DOCKER_PLATFORM -v "$ROOT":/work \
        -w "/work/${app#$ROOT/}/shop" "$IMAGE" \
        "/work/${BIN#$ROOT/}/askr" mcp:install "$@" 2>&1
    fi
  }
  rm -f "$app/shop/.mcp.json"
  out=$(ins || true)
  check "it writes the file"        "$out" 'Wrote .mcp.json'
  check "and names the others"      "$out" 'cursor'
  cfg=$(cat "$app/shop/.mcp.json" 2>/dev/null || true)
  check "with a command a client can run" "$cfg" '"command": "askr"'
  check "and mcpServers, not servers"     "$cfg" '"mcpServers"'

  out=$(ins || true)
  check "a second run changes nothing" "$out" 'already has an askr server'

  # The file belongs to the user. It carries comments, ordering and
  # formatting that a parse-and-rewrite loses -- and half of these files
  # are JSONC, which our parser does not read at all. The last time this
  # repository edited a file a user owns, it replaced the wrong thing and
  # reported success.
  printf '// a comment, which is legal here\n{\n  "mcpServers": {}\n}\n' \
    > "$app/shop/.mcp.json"
  before=$(cksum < "$app/shop/.mcp.json")
  out=$(ins || true)
  after=$(cksum < "$app/shop/.mcp.json")
  check "an existing file is not rewritten" "$out" 'yours to edit'
  check "and says what to add"              "$out" '"askr": { "command"'
  if [ "$before" = "$after" ]; then
    echo "  ok    and is left byte for byte as it was"
  else
    echo "  FAIL  and is left byte for byte as it was"
    fail=1
  fi

  # The exit code and the absence of a file, not only the message. A
  # mutation that printed the complaint and then fell back to the default
  # client passed a check that looked only at the text.
  rm -f "$app/shop/.cursor/mcp.json"
  out=$(ins emacs) && rc=0 || rc=$?
  check "an unknown client is refused"  "$out" 'no client called'
  check "and the known ones are listed" "$out" '.vscode/mcp.json'
  if [ "$rc" -ne 0 ]; then
    echo "  ok    and it exits non-zero"
  else
    echo "  FAIL  and it exits non-zero"
    fail=1
  fi
  if [ ! -f "$app/shop/.cursor/mcp.json" ]; then
    echo "  ok    having written nothing"
  else
    echo "  FAIL  having written nothing"
    fail=1
  fi

  echo
  echo "- with no project at all"
  mkdir -p "$BUILD/mcpnone"
  out=$(run_mcp_in "${BUILD#$ROOT/}/mcpnone" 2>/dev/null || true)
  check "the handshake answers anyway"     "$out" '"serverInfo"'
  check "and nothing leaked to stdout"     "$out" '^{'
  # Without a project the tool cannot run at all -- and that is the one case
  # where isError is actually true.
  check "build says a project is missing"  "$out" 'No askr.toml'
  check "and that is a real tool error"    "$out" '"isError":true'
  pure_json "$out"

  echo
  if [ "$fail" -ne 0 ]; then
    echo "mcp:check failed."
    return 1
  fi
  echo "mcp:check holds: the server answers without a project that builds."
}

cmd_test() {
  prepare
  fpc_run tests/askr_tests.lpr
  bin_run_quiet askr_tests || return 1
  echo
  # Den andre suiten er skrevet med Askr.Testing, og tester samtidig
  # rammeverket den er skrevet med.
  fpc_run tests/askr_runtime_tests.lpr
  bin_run_quiet askr_runtime_tests || return 1
  echo
  # Krypto mot offisielle vektorer. Denne suiten er ikke som de andre: en
  # SHA-256 med feil byterekkefølge er stabil, konsistent og verdiløs, og
  # ingenting i en app ville sagt fra. Vektorene er hele dekningen.
  fpc_run tests/askr_crypto_tests.lpr
  bin_run_quiet askr_crypto_tests || return 1
  echo
  # Rún: transpileren mot en ekte SQLite-database, inkludert at hver av de
  # seks comptime-feilene fortsatt sier det den skal.
  fpc_run tests/askr_run_tests.lpr
  bin_run_quiet askr_run_tests || return 1
  echo
  # TLS-suiten hopper over seg selv der OpenSSL ikke finnes, og sier hvorfor.
  cmd_tls_certs >/dev/null
  fpc_run tests/askr_tls_tests.lpr
  bin_run_quiet askr_tls_tests || return 1
  echo
  # De to serversuitene hopper over seg selv uten klientbibliotek eller
  # server å snakke med.
  cmd_pg || return 1
  echo
  cmd_mysql || return 1
  echo
  # Desktop-suiten hopper over seg selv uten WebKitGTK. Den ekte kjøringen,
  # med vindu og skjerm, er ./askr desktop:linux.
  fpc_run tests/askr_desktop_tests.lpr
  bin_run_quiet askr_desktop_tests || return 1
  echo
  # WebView2-bindingen kan ikke kjøres herfra. Dette sjekker det som kan
  # sjekkes: at COM-deklarasjonene og callback-klassene typesjekker.
  fpc_run tools/probes/webview2_vtable.lpr
  bin_run_quiet webview2_vtable
  echo
  # MCP-serveren skal svare uten at prosjektet bygger. Den porten krever en
  # ekte prosess med ekte rør og kan derfor ikke stå i Pascal-suiten — men
  # den skal kjøres hver gang, ellers råtner den.
  cmd_mcp_check || return 1
}

cmd_run() {
  cmd_build
  port=${1:-8080}
  if have_local_fpc; then
    bin_run hello "$port"
  else
    # I container må appen lytte på 0.0.0.0 for at -p skal nå fram.
    ensure_image
    echo "Askr på http://127.0.0.1:$port (i container)"
    docker run --rm -it -p "$port:$port" -v "$ROOT":/work -w /work "$IMAGE" \
      /work/.build/bin/hello "$port" 0.0.0.0
  fi
}

# CLI-en fra PRD-en: askr new, askr serve, askr build, askr make.
cmd_cli() {
  prepare
  fpc_run cli/askr.lpr
  echo "Built .build/bin/askr"
  echo
  echo "Put it on PATH, and point ASKR_HOME here:"
  echo "  export PATH=\"$BIN:\$PATH\""
  echo "  export ASKR_HOME=\"$ROOT\""
}

cmd_clean() {
  rm -rf "$BUILD"
  echo "Ryddet .build"
}

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  spike) shift; cmd_spike "$@" ;;
  urd)   shift; cmd_urd "$@" ;;
  schema) shift; cmd_schema "$@" ;;
  web)   shift; cmd_web "$@" ;;
  lauf)  shift; cmd_lauf "$@" ;;
  lauf:play) shift; cmd_lauf_play "$@" ;;
  lauf:check) shift; cmd_lauf_check "$@" ;;
  db:up) shift; cmd_db_up "$@" ;;
  db:down) shift; cmd_db_down "$@" ;;
  test)  shift; cmd_test "$@" ;;
  test:amd64) shift; ASKR_ARCH=amd64 exec "$0" test "$@" ;;
  mcp:check) shift; cmd_mcp_check "$@" ;;
  api:check) shift; cmd_api_check "$@" ;;
  make:check) shift; cmd_make_check "$@" ;;
  seo:check) shift; cmd_seo_check "$@" ;;
  session:check) shift; cmd_session_check "$@" ;;
  auth:check) shift; cmd_auth_check "$@" ;;
  qr:check) shift; cmd_qr_check "$@" ;;
  ws:check) shift; cmd_ws_check "$@" ;;
  storage:check) shift; cmd_storage_check "$@" ;;
  check) shift; cmd_check "$@" ;;
  tls:certs) shift; cmd_tls_certs "$@" ;;
  mysql) shift; cmd_mysql "$@" ;;
  pg)    shift; cmd_pg "$@" ;;
  desktop:linux) shift; cmd_desktop_linux "$@" ;;
  run:demo) shift; cmd_run_demo "$@" ;;
  run)   shift; cmd_run "$@" ;;
  cli)   shift; cmd_cli "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  *)
    cat <<USAGE
askr — byggskript for rammeverket (midlertidig, se steg 6)

  ./askr build    bygg alle units og eksempelappen
  ./askr test     bygg og kjør testsuiten
  ./askr check    samme, med område- og overflytkontroll slått på
  ./askr mcp:check
                  MCP-serveren mot et prosjekt som ikke kompilerer,
                  og mot ingen prosjekt. Den porten kan ikke stå i
                  Pascal-suiten — den krever en ekte prosess
  ./askr api:check
                  API-laget ende-til-ende mot en ekte app: dokumentet
                  validert av en ekte OpenAPI-validator, drift mot
                  rutetabellen begge veier, og tokens, scopes,
                  konvolutt, CORS og rate limit over socket
  ./askr make:check
                  generatorene mot et ekte prosjekt: make model med hver
                  type, make resource for web og API, bygget, migrert og
                  testet på SQLite, Postgres og MySQL; openapi --check og
                  en validator; API-et over en socket; sidene i Chrome med
                  axe. Krever ./askr db:up; node og Chrome for de to siste.
                  Krever ./askr db:up
  ./askr session:check
                  sesjoner i databasen: to app-prosesser mot samme base,
                  logg inn på den ene, bli kjent på den andre, logg ut på
                  den andre og vær ute på den første — på SQLite, Postgres
                  og MySQL, med minne som kontroll. Krever ./askr db:up
  ./askr auth:check
                  en app fra askr new --auth over en socket: registrer,
                  bekreft adressen med lenka fra mailen i loggen, og ingen
                  annen lenke åpner dashbordet. Bare SQLite
  ./askr qr:check
                  QR-koder på alle nivåer, fra noen få byte til det
                  versjon 40 rommer, lest tilbake av Chromes egen
                  strekkodeleser. Krever node og Chrome på macOS
  ./askr ws:check
                  Autobahn-testsuiten mot en ekkoserver bygget på Askr:
                  hver case unntatt komprimering og ytelse. Krever
                  crossbario/autobahn-testsuite
  ./askr storage:check
                  S3-disken mot en ekte S3-server som sjekker hver
                  signatur (Versity-gatewayen). Krever versity/versitygw
  ./askr test:amd64
                  samme suite bygget og kjørt for x86_64 i container.
                  Arkitektur er en ekte akse: 0.9.0 kompilerte ikke der,
                  og 705 tester på aarch64 sa ingenting
  ./askr tls:certs
                  lag selvsignerte sertifikater i .build/tls
  ./askr run [port]
                  bygg og start eksempelappen (standard port 8080)
  ./askr spike    bygg og kjør libpq-spiken mot Postgres
  ./askr run:demo [n]
                  Rún ende-til-ende mot SQLite: transpiler, kompiler,
                  kjør. n = ekstra tabeller å måle introspeksjonen mot
  ./askr urd      bygg og kjør Urd ende-til-ende mot Postgres
  ./askr schema   migrer, introspiser og generer typede kolonner
  ./askr web      bygg frontend og start Inertia-demoen (Svelte 5)
  ./askr lauf     kjør Lauf-suiten (UI-komponentene, krever node)
  ./askr lauf:play
                  bygg og server lekegrinda på 4173
  ./askr lauf:check
                  kontrast og skjermdump i ekte Chrome, lys og mørk
  ./askr desktop:linux
                  bygg GTK-imaget og kjør Linux-webviewen under Xvfb
  ./askr pg       kjør Postgres-suiten (krever ./askr db:up)
  ./askr mysql    kjør MySQL-suiten (krever ./askr db:up)
  ./askr db:up    start Postgres (5433) og MySQL (3308) for utvikling
  ./askr db:down  stopp den igjen
  ./askr cli      bygg CLI-en (askr new / serve / build / make)
  ./askr clean    slett .build

Bruker fpc fra PATH hvis den finnes, ellers docker ($IMAGE).
USAGE
    exit 1
    ;;
esac
