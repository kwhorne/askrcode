# The Free Pascal toolchain for Askr.
#
# The official freepascal/fpc image is musl based, and FPC 3.2.2's cprt0.o
# is built against glibc. The combination does not link as soon as cthreads
# pulls in libc. Debian's own fpc package is built against the glibc that
# sits in the same image, and is therefore what actually works.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      fpc \
      binutils \
      libc6-dev \
      gcc \
      curl \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# gcc is here for crtbegin.o/crtend.o, which FPC warns about without
# failing — and because step 2 needs a C toolchain for libpq and OpenSSL
# anyway.

WORKDIR /work

# libpq in a layer of its own, so that the fpc layer above keeps its cache
# when the drivers grow. The headers are not needed — the binding is
# declared against the C ABI directly and loaded with dlopen on first use.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpq5 postgresql-client \
 && rm -rf /var/lib/apt/lists/*

# The MySQL client is MariaDB's connector. It is ABI compatible with
# libmysqlclient, is in Debian, and is on Homebrew as mariadb-connector-c —
# that is, one binding covering both servers. mariadb-client is here for
# setting up schemas in the tests.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libmariadb3 mariadb-client \
 && rm -rf /var/lib/apt/lists/*

# libvips for Askr.Image.Vips. The same pattern as libpq and OpenSSL: it is
# loaded with dlopen on first use, so the binary starts without it, and an
# app that never resizes an image pays nothing.
#
# It is here and not on the macOS side because that machine has no
# Homebrew — and because this is already how the TLS tests are done:
# anything that needs a system library is tried in the container, and the
# suite skips itself where the library is missing.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libvips42 \
 && rm -rf /var/lib/apt/lists/*
