# The Askr toolchain plus GTK3 and WebKitGTK, for actually running the
# Linux webview.
#
# Kept out of the main image deliberately: WebKitGTK pulls in a few hundred
# megabytes, and ./askr test should not pay for that. The desktop unit
# compiles without these packages anyway — everything is loaded with
# dlopen — so it is only the running that needs them.
#
#   ./askr desktop:linux
ARG BASE=askr-fpc:bookworm
FROM ${BASE}

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libgtk-3-0 \
      libwebkit2gtk-4.1-0 \
      xvfb \
      dbus-x11 \
 && rm -rf /var/lib/apt/lists/*

# WebKitGTK wants a process sandbox of its own, which is not allowed in an
# ordinary container. Without this the web engine does not start.
ENV WEBKIT_DISABLE_COMPOSITING_MODE=1 \
    WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1 \
    GDK_BACKEND=x11 \
    NO_AT_BRIDGE=1

WORKDIR /work
